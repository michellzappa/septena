<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_card_bg"
    android:orientation="vertical"
    android:paddingStart="14dp"
    android:paddingTop="12dp"
    android:paddingEnd="14dp"
    android:paddingBottom="10dp">

    <LinearLayout
        android:id="@+id/widget_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingBottom="8dp">

        <ImageView
            android:id="@+id/widget_header_icon"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_widget_sun" />

        <TextView
            android:id="@+id/widget_header_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/widget_today_name"
            android:textColor="@color/widget_text_primary"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_header_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="10dp"
            android:textColor="@color/widget_text_secondary"
            android:textSize="13sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <ImageView
            android:id="@+id/widget_add_button"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:contentDescription="@string/widget_add_task"
            android:padding="5dp"
            android:src="@drawable/ic_widget_plus" />
    </LinearLayout>

    <TextView
        android:id="@+id/widget_empty_label"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:textColor="@color/widget_text_secondary"
        android:textSize="13.5sp"
        android:visibility="gone" />

    <!-- Row 0 -->
    <LinearLayout
        android:id="@+id/widget_row_0"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:minHeight="30dp"
        android:orientation="horizontal"
        android:paddingVertical="3dp"
        android:visibility="gone">
        <ImageView
            android:id="@+id/widget_row_0_check"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:contentDescription="@string/widget_complete_task"
            android:padding="4dp"
            android:src="@drawable/widget_checkbox" />
        <TextView
            android:id="@+id/widget_row_0_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/widget_text_primary"
            android:textSize="14sp" />
        <TextView
            android:id="@+id/widget_row_0_meta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:maxLines="1"
            android:textColor="@color/widget_text_secondary"
            android:textSize="11.5sp"
            android:visibility="gone" />
    </LinearLayout>

    <!-- Row 1 -->
    <LinearLayout
        android:id="@+id/widget_row_1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:minHeight="30dp"
        android:orientation="horizontal"
        android:paddingVertical="3dp"
        android:visibility="gone">
        <ImageView
            android:id="@+id/widget_row_1_check"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:contentDescription="@string/widget_complete_task"
            android:padding="4dp"
            android:src="@drawable/widget_checkbox" />
        <TextView
            android:id="@+id/widget_row_1_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/widget_text_primary"
            android:textSize="14sp" />
        <TextView
            android:id="@+id/widget_row_1_meta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:maxLines="1"
            android:textColor="@color/widget_text_secondary"
            android:textSize="11.5sp"
            android:visibility="gone" />
    </LinearLayout>

    <!-- Row 2 -->
    <LinearLayout
        android:id="@+id/widget_row_2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:minHeight="30dp"
        android:orientation="horizontal"
        android:paddingVertical="3dp"
        android:visibility="gone">
        <ImageView
            android:id="@+id/widget_row_2_check"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:contentDescription="@string/widget_complete_task"
            android:padding="4dp"
            android:src="@drawable/widget_checkbox" />
        <TextView
            android:id="@+id/widget_row_2_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/widget_text_primary"
            android:textSize="14sp" />
        <TextView
            android:id="@+id/widget_row_2_meta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:maxLines="1"
            android:textColor="@color/widget_text_secondary"
            android:textSize="11.5sp"
            android:visibility="gone" />
    </LinearLayout>

    <!-- Row 3 -->
    <LinearLayout
        android:id="@+id/widget_row_3"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:minHeight="30dp"
        android:orientation="horizontal"
        android:paddingVertical="3dp"
        android:visibility="gone">
        <ImageView
            android:id="@+id/widget_row_3_check"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:contentDescription="@string/widget_complete_task"
            android:padding="4dp"
            android:src="@drawable/widget_checkbox" />
        <TextView
            android:id="@+id/widget_row_3_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/widget_text_primary"
            android:textSize="14sp" />
        <TextView
            android:id="@+id/widget_row_3_meta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:maxLines="1"
            android:textColor="@color/widget_text_secondary"
            android:textSize="11.5sp"
            android:visibility="gone" />
    </LinearLayout>

    <!-- Row 4 -->
    <LinearLayout
        android:id="@+id/widget_row_4"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:minHeight="30dp"
        android:orientation="horizontal"
        android:paddingVertical="3dp"
        android:visibility="gone">
        <ImageView
            android:id="@+id/widget_row_4_check"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:contentDescription="@string/widget_complete_task"
            android:padding="4dp"
            android:src="@drawable/widget_checkbox" />
        <TextView
            android:id="@+id/widget_row_4_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/widget_text_primary"
            android:textSize="14sp" />
        <TextView
            android:id="@+id/widget_row_4_meta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:maxLines="1"
            android:textColor="@color/widget_text_secondary"
            android:textSize="11.5sp"
            android:visibility="gone" />
    </LinearLayout>

    <!-- Row 5 -->
    <LinearLayout
        android:id="@+id/widget_row_5"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:minHeight="30dp"
        android:orientation="horizontal"
        android:paddingVertical="3dp"
        android:visibility="gone">
        <ImageView
            android:id="@+id/widget_row_5_check"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:contentDescription="@string/widget_complete_task"
            android:padding="4dp"
            android:src="@drawable/widget_checkbox" />
        <TextView
            android:id="@+id/widget_row_5_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/widget_text_primary"
            android:textSize="14sp" />
        <TextView
            android:id="@+id/widget_row_5_meta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:maxLines="1"
            android:textColor="@color/widget_text_secondary"
            android:textSize="11.5sp"
            android:visibility="gone" />
    </LinearLayout>

    <TextView
        android:id="@+id/widget_more_label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="32dp"
        android:paddingTop="4dp"
        android:textColor="@color/widget_text_secondary"
        android:textSize="12sp"
        android:visibility="gone" />
</LinearLayout>
