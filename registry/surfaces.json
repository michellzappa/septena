{
  "version": 1,
  "description": "Notices, destructive/fork prompts, toast contracts, and task composer/inspector attribute definitions (ADR 0015, docs/SEPTASK_APPKIT_SURFACES.md).",
  "notices": {
    "maxConcurrentExplainers": 1,
    "dismissTitle": "Dismiss",
    "items": [
      {
        "id": "signIn",
        "kind": "actionNeeded",
        "priority": 0,
        "icon": "notice.sign_in",
        "dismissScope": "device",
        "dismissible": true,
        "title": "Not signed in",
        "primaryTitle": "Sign in…",
        "featureId": "sync.backend",
        "detail": "Your changes stay on this device until you sign in.",
        "platformDetails": [
          { "platforms": ["macos"], "detail": "Your changes stay on this Mac until you sign in." },
          { "platforms": ["ipados"], "detail": "Your changes stay on this iPad until you sign in." },
          { "platforms": ["ios"], "detail": "Your changes stay on this iPhone until you sign in." }
        ]
      },
      {
        "id": "rolledIn",
        "kind": "info",
        "priority": 1,
        "icon": "notice.rolled_in",
        "dismissScope": "accountDay",
        "dismissible": true,
        "featureId": "lists.today",
        "title": { "one": "1 task rolled into Today", "other": "{count} tasks rolled into Today" }
      },
      {
        "id": "getStarted",
        "kind": "info",
        "priority": 2,
        "explainerSlot": true,
        "icon": "notice.get_started",
        "dismissScope": "account",
        "dismissible": true,
        "title": "Get started with Septena",
        "featureId": "lists.today",
        "steps": [
          { "id": "connectAI", "title": "Connect your agent", "detail": "Let Claude or your own agent work your list" },
          { "id": "importTasks", "title": "Bring in your tasks", "detail": "Import from another app" },
          {
            "id": "addTask",
            "title": "Add your first task",
            "detail": "It lands in your Inbox until you schedule or file it",
            "platformDetails": [{ "platforms": ["macos"], "detail": "Or press ⌃⌥Space anywhere on your Mac" }]
          }
        ]
      },
      {
        "id": "trialEnd",
        "kind": "info",
        "priority": 1,
        "icon": "notice.trial_end",
        "dismissScope": "account",
        "dismissible": true,
        "upsell": "trial_end",
        "primaryTitle": "See Plus",
        "featureId": "sync.backend"
      },
      {
        "id": "secondDevice",
        "kind": "info",
        "priority": 1,
        "icon": "notice.second_device",
        "dismissScope": "account",
        "dismissible": true,
        "upsell": "second_device",
        "primaryTitle": "See Plus",
        "featureId": "sync.backend"
      },
      {
        "id": "weeklySweep",
        "kind": "info",
        "priority": 3,
        "icon": "notice.weekly_sweep",
        "dismissScope": "accountWeek",
        "dismissible": true,
        "title": { "one": "1 task faded this week", "other": "{count} tasks faded this week" },
        "primaryTitle": "Sweep",
        "featureId": "fade.sweep"
      },
      {
        "id": "fadedPile",
        "kind": "info",
        "priority": 5,
        "icon": "notice.weekly_sweep",
        "dismissScope": "none",
        "dismissible": false,
        "title": "Tasks without activity for 14 days",
        "detail": "Open a task or choose Keep to bring it back, or sweep the list to let the rest go.",
        "primaryTitle": "Sweep…",
        "featureId": "lists.faded"
      },
      {
        "id": "fadeIntro",
        "kind": "info",
        "priority": 4,
        "explainerSlot": true,
        "icon": "notice.fade_intro",
        "dismissScope": "device",
        "dismissible": true,
        "title": "Inactive tasks start to fade",
        "detail": "Undated tasks fade after 14 days without activity and move to Faded. Open or edit a task to bring it back. You can turn this off in Settings.",
        "featureId": "task.aging"
      }
    ]
  },
  "prompts": {
    "safetyContract": { "cancelIsDefaultButton": true, "confirmCarriesDestructiveRole": true },
    "cancelTitle": "Cancel",
    "items": [
      {
        "id": "deletePermanently",
        "kind": "destructive",
        "title": { "one": "Delete this task permanently?", "other": "Delete {count} tasks permanently?" },
        "message": "You can’t undo this.",
        "confirmTitle": "Delete Permanently",
        "featureId": "lists.recently-deleted"
      },
      {
        "id": "deleteSection",
        "kind": "destructive",
        "title": "Delete this section?",
        "message": "Its tasks stay in the project.",
        "confirmTitle": "Delete Section",
        "featureId": "places.sections"
      },
      {
        "id": "deleteArea",
        "kind": "destructive",
        "confirmTitle": "Delete",
        "untitledName": "Area",
        "counts": ["projects", "tasks"],
        "variants": [
          { "id": "empty", "when": { "projects": 0, "tasks": 0 }, "title": "Delete “{name}”?", "message": "You can undo this." },
          {
            "id": "tasksOnly",
            "when": { "projects": 0 },
            "title": "Delete “{name}” and its {taskPhrase}?",
            "message": "The tasks move to Recently Deleted. You can undo this."
          },
          {
            "id": "projectsOnly",
            "when": { "tasks": 0 },
            "title": "Delete “{name}” and its {projectPhrase}?",
            "message": "You can undo this.",
            "l10nKeys": { "title": "Delete “{name}” and its {projectPhrase}? (projects only)" }
          },
          {
            "id": "projectsAndTasks",
            "title": "Delete “{name}”, its {projectPhrase} and {taskPhrase}?",
            "message": "The tasks move to Recently Deleted. You can undo this."
          }
        ],
        "featureId": "places.areas"
      },
      {
        "id": "deleteProject",
        "kind": "destructive",
        "confirmTitle": "Delete",
        "untitledName": "Project",
        "counts": ["tasks"],
        "variants": [
          { "id": "empty", "when": { "tasks": 0 }, "title": "Delete “{name}”?", "message": "You can undo this." },
          { "id": "withTasks", "title": "Delete “{name}” and its {taskPhrase}?", "message": "The tasks move to Recently Deleted. You can undo this." }
        ],
        "featureId": "places.projects"
      },
      {
        "id": "clearLogged",
        "kind": "destructive",
        "title": { "one": "Clear 1 logged item from “{name}”?", "other": "Clear {count} logged items from “{name}”?" },
        "message": "Cleared items move to Recently Deleted. You can undo this.",
        "confirmTitle": "Clear",
        "featureId": "lists.logbook"
      },
      {
        "id": "deleteAccount",
        "kind": "destructive",
        "title": "Delete Account?",
        "message": "Your tasks, areas, projects, and conversations are erased from the server and this device.",
        "confirmTitle": "Delete Account",
        "featureId": "account.delete"
      },
      {
        "id": "rescheduleFixedRepeat",
        "kind": "fork",
        "title": "Reschedule repeating task?",
        "message": "Move only this task, or update the repeating schedule to the new date?",
        "options": [{ "id": "exception", "title": "Only This Task" }, { "id": "updateRule", "title": "Update Schedule" }],
        "featureId": "task.repeat"
      }
    ],
    "countPhrases": [
      { "id": "tasks", "label": { "one": "1 task", "other": "{count} tasks" } },
      { "id": "projects", "label": { "one": "1 project", "other": "{count} projects" } }
    ],
    "text": [
      { "id": "newSection", "title": "New Section", "placeholder": "Section name", "confirmTitle": "Add", "featureId": "places.sections" },
      { "id": "renameSection", "title": "Rename Section", "placeholder": "Section name", "confirmTitle": "Rename", "featureId": "places.sections" },
      { "id": "newArea", "title": "New Area", "placeholder": "Area name", "confirmTitle": "Create", "featureId": "places.areas" },
      { "id": "renameArea", "title": "Rename Area", "placeholder": "Area name", "confirmTitle": "Rename", "featureId": "places.areas" },
      { "id": "newProject", "title": "New Project", "placeholder": "Project name", "confirmTitle": "Create", "featureId": "places.projects" },
      { "id": "renameProject", "title": "Rename Project", "placeholder": "Project name", "confirmTitle": "Rename", "featureId": "places.projects" }
    ],
    "error": { "title": "Error", "confirmTitle": "OK" }
  },
  "toasts": {
    "templates": {
      "deferred": { "format": "Moved to {date}", "l10nKeys": { "format": "Moved to {date} (When)" }, "undoable": false },
      "moved": { "format": "Moved to {destination}", "undoable": true },
      "deletedSingle": { "format": "“{title}” deleted", "emptyTitleFormat": "Task deleted", "undoable": true },
      "deletedBulk": { "format": { "one": "Task deleted", "other": "{count} tasks deleted" }, "undoable": true },
      "movedBulk": { "format": { "one": "Moved to {destination}", "other": "Moved {count} tasks to {destination}" }, "undoable": true }
    }
  },
  "firstRun": {
    "featureId": "onboarding.first-run",
    "completionSetting": "onboardedAt",
    "prompts": {
      "setup": "Set up Septena for me using https://septena.app/agents.md",
      "first": "Set up my Septena areas, projects, and tasks by following https://api.septena.app/onboard.md"
    },
    "steps": [
      {
        "id": "welcome",
        "kind": "intro",
        "icon": "onboarding.welcome",
        "title": "Welcome to Septena",
        "body": "Tasks that think with you.",
        "points": [
          { "icon": "onboarding.devices", "title": "On every device", "detail": "Your tasks stay in step on iPhone, iPad and Mac." },
          {
            "icon": "onboarding.agent",
            "title": "Your agents do the work",
            "detail": "You decide when it’s done."
          },
          { "icon": "onboarding.notes", "title": "Notes keep the context", "detail": "Each project has notes, so you and Claude know what it’s for." }
        ],
        "primary": { "title": "Continue", "action": "next" }
      },
      {
        "id": "account",
        "kind": "account",
        "icon": "onboarding.account",
        "title": "Sign in to sync",
        "body": "Sign in with Apple to keep your tasks on all your devices and to let Claude connect. Septena never sees your Apple password.",
        "footnote": "If you skip this, your tasks stay on this device until you sign in.",
        "skipWhen": "signedIn",
        "primary": { "title": "Sign in with Apple", "action": "signIn" },
        "secondary": { "title": "Not now", "action": "next" }
      },
      {
        "id": "moveIn",
        "kind": "choices",
        "icon": "onboarding.move_in",
        "title": "Bring your tasks",
        "body": "Start from the list you already have, or start empty.",
        "completesGetStartedStep": "importTasks",
        "choices": [
          {
            "id": "things",
            "icon": "onboarding.things",
            "title": "From Things",
            "detail": "Copies your areas, projects and tasks. Nothing in Things changes.",
            "action": "importThings",
            "platforms": ["ios", "ipados", "macos"]
          },
          {
            "id": "reminders",
            "icon": "settings.reminders",
            "title": "From Reminders",
            "detail": "Pick a Reminders list. Each reminder you bring in moves to your Inbox, and Septena deletes it from Reminders.",
            "action": "importReminders",
            "platforms": ["ios", "ipados", "macos"]
          },
          {
            "id": "fresh",
            "icon": "onboarding.fresh",
            "title": "Start empty",
            "detail": "Add tasks as they come up.",
            "action": "next",
            "platforms": ["ios", "ipados", "macos", "web", "android", "windows"]
          }
        ]
      },
      {
        "id": "connectClaude",
        "kind": "connectAgent",
        "icon": "settings.claude",
        "title": "Connect Claude",
        "body": "Claude reads and changes your tasks through your Septena account. You decide which tasks it works on.",
        "requires": "signedIn",
        "completesGetStartedStep": "connectAI",
        "instructions": [
          "Copy the setup prompt and paste it into Claude.",
          "When Claude shows a code, enter it below.",
          "Paste the first prompt. Claude sets up your areas and projects with you."
        ],
        "primary": { "title": "Copy setup prompt", "action": "copySetupPrompt" },
        "tertiary": { "title": "Copy first prompt", "action": "copyFirstPrompt" },
        "secondary": { "title": "Later", "action": "next" },
        "afterDone": { "title": "Continue", "action": "next" }
      },
      {
        "id": "done",
        "kind": "finish",
        "icon": "onboarding.done",
        "title": "You’re all set",
        "body": "Today shows what to do now. Anything you skipped stays on the Get started list.",
        "returningTitle": "Welcome back",
        "returningBody": "This account is already set up. Your tasks are syncing to this device.",
        "primary": { "title": "Open Today", "action": "finish" }
      }
    ]
  },
  "taskAttributes": [
    { "id": "notes", "label": "Notes", "icon": "action.notes", "commitContract": "closeCommits", "surfaceTier": "field", "featureId": "task.notes" },
    { "id": "when", "label": "When", "icon": "action.when", "commitContract": "pickCommits", "surfaceTier": "popover", "featureId": "task.when-deadline" },
    { "id": "deadline", "label": "Deadline", "icon": "action.deadline", "commitContract": "pickCommits", "surfaceTier": "popover", "featureId": "task.when-deadline" },
    { "id": "reminder", "label": "Remind", "icon": "action.reminder", "commitContract": "pickCommits", "surfaceTier": "popover", "featureId": "task.alerts" },
    { "id": "repeat", "label": "Repeat", "icon": "action.repeat", "commitContract": "closeCommits", "surfaceTier": "popover", "featureId": "task.repeat" },
    { "id": "star", "label": "Star", "icon": "action.star", "commitContract": "pickCommits", "surfaceTier": "inline", "featureId": "lists.starred" },
    { "id": "list", "label": "List", "icon": "action.move", "commitContract": "pickCommits", "surfaceTier": "popover", "featureId": "places.projects" },
    { "id": "tags", "label": "Tags", "countLabel": { "one": "{count} tag", "other": "{count} tags" }, "icon": "action.tag", "commitContract": "pickCommits", "surfaceTier": "popover", "featureId": "task.tags", "editOnly": true },
    { "id": "checklist", "label": "Checklist", "icon": "action.checklist", "commitContract": "pickCommits", "surfaceTier": "inline", "featureId": "task.checklists", "editOnly": true },
    { "id": "attachments", "label": "Attachments", "countLabel": { "one": "{count} file", "other": "{count} files" }, "icon": "action.attachment", "commitContract": "pickCommits", "surfaceTier": "inline", "featureId": "task.attachments", "editOnly": true },
    { "id": "discuss", "label": "Discuss", "workingLabel": "Thinking…", "icon": "action.discuss", "commitContract": "closeCommits", "surfaceTier": "inline", "featureId": "ai.discuss", "editOnly": true },
    { "id": "paste", "label": "Paste", "icon": "action.paste", "commitContract": "pickCommits", "surfaceTier": "chip", "featureId": "capture.quick-entry" }
  ]
}
