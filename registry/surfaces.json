        "format": "Moved to {destination}",
        "undoable": true
      },
      "deletedSingle": {
        "format": "“{title}” deleted",
        "emptyTitleFormat": "Task deleted",
        "undoable": true
      },
      "deletedBulk": {
        "format": {
          "one": "Task deleted",
          "other": "{count} tasks deleted"
        },
        "undoable": true
      },
      "movedBulk": {
        "format": {
          "one": "Moved to {destination}",
