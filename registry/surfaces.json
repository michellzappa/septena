    { "id": "repeat", "label": "Repeat", "icon": "action.repeat", "commitContract": "closeCommits", "surfaceTier": "popover", "featureId": "task.repeat" },
    { "id": "star", "label": "Favorite", "icon": "action.star", "toggle": true, "commitContract": "pickCommits", "surfaceTier": "inline", "featureId": "lists.starred" },
    { "id": "list", "label": "List", "icon": "action.move", "commitContract": "pickCommits", "surfaceTier": "popover", "featureId": "places.projects" },
    { "id": "tags", "label": "Tags", "countLabel": { "one": "{count} tag", "other": "{count} tags" }, "icon": "action.tag", "commitContract": "pickCommits", "surfaceTier": "popover", "featureId": "task.tags", "editOnly": true },
    { "id": "checklist", "label": "Checklist", "icon": "action.checklist", "commitContract": "pickCommits", "surfaceTier": "inline", "featureId": "task.checklists", "editOnly": true },
    { "id": "attachments", "label": "Attachments", "countLabel": { "one": "{count} file", "other": "{count} files" }, "icon": "action.attachment", "commitContract": "pickCommits", "surfaceTier": "inline", "featureId": "task.attachments", "editOnly": true },
    { "id": "discuss", "label": "Discuss", "workingLabel": "Thinking…", "icon": "action.discuss", "commitContract": "closeCommits", "surfaceTier": "inline", "featureId": "ai.discuss", "editOnly": true },
    { "id": "history", "label": "History", "icon": "action.history", "commitContract": "pickCommits", "surfaceTier": "inline", "featureId": "task.history", "editOnly": true }
  ],
  "taskPage": {
    "id": "taskPage",
    "featureId": "task.page",
    "blocks": [
      { "id": "taskPage.header", "kind": "header", "depths": ["inline", "page"], "featureId": "lists.today" },
      { "id": "taskPage.notes", "kind": "notes", "attribute": "notes", "depths": ["inline", "page"], "featureId": "task.notes" },
      { "id": "taskPage.attributes", "kind": "attributes", "depths": ["inline", "page"], "featureId": "lists.today" },
      { "id": "taskPage.checklist", "kind": "checklist", "attribute": "checklist", "depths": ["inline", "page"], "featureId": "task.checklists", "editOnly": true },
      { "id": "taskPage.attachments", "kind": "attachments", "attribute": "attachments", "depths": ["inline", "page"], "featureId": "task.attachments", "editOnly": true },
      { "id": "taskPage.conversation", "kind": "conversation", "label": "Conversation", "depths": ["page"], "featureId": "ai.discuss", "editOnly": true },
      { "id": "taskPage.provenance", "kind": "provenance", "label": "Added by", "selfLabel": "You", "agentFallbackName": "Claude", "icon": "task.added_by_agent", "depths": ["page"], "featureId": "task.provenance", "editOnly": true },
      { "id": "taskPage.history", "kind": "history", "attribute": "history", "depths": ["page"], "featureId": "task.history", "editOnly": true }
    ]
  },
