      { "id": "taskPage.provenance", "kind": "provenance", "label": "Added by", "selfLabel": "You", "agentFallbackName": "Claude", "icon": "task.added_by_agent", "depths": ["page", "review"], "featureId": "task.provenance", "editOnly": true },
