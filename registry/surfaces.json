{
  "version": 1,
  "description": "Notices, destructive/fork prompts, toast contracts, and task composer/inspector attribute definitions (ADR 0015, docs/SEPTASK_APPKIT_SURFACES.md).",
  "notices": {
    "maxConcurrentExplainers": 1,
    "dismissTitle": "Dismiss",
    "items": [
      {
        "id": "signIn",
        "kind": "actionNeeded",
        "priority": 0,
        "icon": "notice.sign_in",
        "dismissScope": "device",
        "dismissible": true,
        "title": "Not signed in",
        "primaryTitle": "Sign in…",
        "featureId": "sync.backend",
        "detail": "Your changes stay on this device until you sign in.",
        "platformDetails": [
          {
            "platforms": [
              "macos"
            ],
            "detail": "Your changes stay on this Mac until you sign in."
          },
          {
            "platforms": [
              "ipados"
            ],
            "detail": "Your changes stay on this iPad until you sign in."
          },
          {
            "platforms": [
              "ios"
            ],
            "detail": "Your changes stay on this iPhone until you sign in."
          }
        ]
      },
      {
        "id": "rolledIn",
        "kind": "info",
        "priority": 1,
        "icon": "notice.rolled_in",
        "dismissScope": "accountDay",
        "dismissible": true,
        "featureId": "lists.today",
        "title": {
          "one": "1 task rolled into Today",
          "other": "{count} tasks rolled into Today"
        }
      },
      {
        "id": "getStarted",
        "kind": "info",
        "priority": 2,
        "explainerSlot": true,
        "icon": "notice.get_started",
        "dismissScope": "account",
        "dismissible": true,
        "title": "Get started with Septena",
        "featureId": "lists.today",
        "steps": [
          {
            "id": "connectAI",
            "title": "Connect your agent",
            "detail": "Let Claude or your own agent work your list"
          },
          {
            "id": "importTasks",
            "title": "Bring in your tasks",
            "detail": "Import from another app"
          },
          {
            "id": "addTask",
            "title": "Add your first task",
            "detail": "It lands in your Inbox until you schedule or file it",
            "platformDetails": [
              {
                "platforms": [
                  "macos"
                ],
                "detail": "Or press ⌃⌥Space anywhere on your Mac"
              }
            ]
          }
        ]
      },
      {
        "id": "trialEnd",
        "kind": "info",
        "priority": 1,
        "icon": "notice.trial_end",
        "dismissScope": "account",
        "dismissible": true,
        "upsell": "trial_end",
        "primaryTitle": "See Plus",
        "featureId": "sync.backend"
      },
      {
        "id": "secondDevice",
        "kind": "info",
        "priority": 1,
        "icon": "notice.second_device",
        "dismissScope": "account",
        "dismissible": true,
        "upsell": "second_device",
        "primaryTitle": "See Plus",
        "featureId": "sync.backend"
      },
      {
        "id": "weeklySweep",
        "kind": "info",
        "priority": 3,
        "icon": "notice.weekly_sweep",
        "dismissScope": "accountWeek",
        "dismissible": true,
        "title": {
          "one": "1 task faded this week",
          "other": "{count} tasks faded this week"
        },
        "detail": "Still want any of them?",
        "primaryTitle": "Review",
        "featureId": "fade.sweep"
      },
      {
        "id": "fadedPile",
        "kind": "info",
        "priority": 5,
        "icon": "notice.weekly_sweep",
        "dismissScope": "none",
        "dismissible": false,
        "title": "Tasks without activity for 14 days",
        "detail": "Open a task or choose Keep to bring it back, or review the list and let the rest go.",
        "primaryTitle": "Review…",
        "featureId": "lists.faded"
      },
      {
        "id": "fadeIntro",
        "kind": "info",
        "priority": 4,
        "explainerSlot": true,
        "icon": "notice.fade_intro",
        "dismissScope": "device",
        "dismissible": true,
        "title": "Inactive tasks start to fade",
        "detail": "Tasks fade after 14 days without activity and move to Review. A deadline or a date ahead keeps a task out. Open or edit a task to bring it back. You can turn this off in Settings.",
        "featureId": "task.aging"
      }
    ]
  },
  "prompts": {
    "safetyContract": {
      "cancelIsDefaultButton": true,
      "confirmCarriesDestructiveRole": true
    },
    "cancelTitle": "Cancel",
    "items": [
      {
        "id": "deletePermanently",
        "kind": "destructive",
        "title": {
          "one": "Delete this task permanently?",
          "other": "Delete {count} tasks permanently?"
        },
        "message": "You can’t undo this.",
        "confirmTitle": "Delete Permanently",
        "featureId": "lists.recently-deleted"
      },
      {
        "id": "emptyTrash",
        "kind": "destructive",
        "title": {
          "one": "Delete 1 deleted task permanently?",
          "other": "Delete all {count} deleted tasks permanently?"
        },
        "message": "You can’t undo this.",
        "confirmTitle": "Empty Trash",
        "featureId": "lists.recently-deleted"
      },
      {
        "id": "deleteSection",
        "kind": "destructive",
        "title": "Delete this section?",
        "message": "Its tasks stay in the project.",
        "confirmTitle": "Delete Section",
        "featureId": "places.sections"
      },
      {
        "id": "deleteArea",
        "kind": "destructive",
        "confirmTitle": "Delete",
        "untitledName": "Area",
        "counts": [
          "projects",
          "tasks"
        ],
        "variants": [
          {
            "id": "empty",
            "when": {
              "projects": 0,
              "tasks": 0
            },
            "title": "Delete “{name}”?",
            "message": "You can undo this."
          },
          {
            "id": "tasksOnly",
            "when": {
              "projects": 0
            },
            "title": "Delete “{name}” and its {taskPhrase}?",
            "message": "The tasks move to Recently Deleted. You can undo this."
          },
          {
            "id": "projectsOnly",
            "when": {
              "tasks": 0
            },
            "title": "Delete “{name}” and its {projectPhrase}?",
            "message": "You can undo this.",
            "l10nKeys": {
              "title": "Delete “{name}” and its {projectPhrase}? (projects only)"
            }
          },
          {
            "id": "projectsAndTasks",
            "title": "Delete “{name}”, its {projectPhrase} and {taskPhrase}?",
            "message": "The tasks move to Recently Deleted. You can undo this."
          }
        ],
        "featureId": "places.areas"
      },
      {
        "id": "deleteProject",
        "kind": "destructive",
        "confirmTitle": "Delete",
        "untitledName": "Project",
        "counts": [
          "tasks"
        ],
        "variants": [
          {
            "id": "empty",
            "when": {
              "tasks": 0
            },
            "title": "Delete “{name}”?",
            "message": "You can undo this."
          },
          {
            "id": "withTasks",
            "title": "Delete “{name}” and its {taskPhrase}?",
            "message": "The tasks move to Recently Deleted. You can undo this."
          }
        ],
        "featureId": "places.projects"
      },
      {
        "id": "clearLogged",
        "kind": "destructive",
        "title": {
          "one": "Clear 1 logged item from “{name}”?",
          "other": "Clear {count} logged items from “{name}”?"
        },
        "message": "Cleared items move to Recently Deleted. You can undo this.",
        "confirmTitle": "Clear",
        "featureId": "lists.logbook"
      },
      {
        "id": "rescheduleFixedRepeat",
        "kind": "fork",
        "title": "Reschedule repeating task?",
        "message": "Move only this task, or update the repeating schedule to the new date?",
        "options": [
          {
            "id": "exception",
            "title": "Only This Task"
          },
          {
            "id": "updateRule",
            "title": "Update Schedule"
          }
        ],
        "featureId": "task.repeat"
      },
      {
        "id": "disconnectAgent",
        "kind": "destructive",
        "title": "Disconnect {name}?",
        "message": "{name} can no longer read or change your tasks. To use it again, connect it again.",
        "confirmTitle": "Disconnect",
        "featureId": "agents.connector"
      },
      {
        "id": "agentKeyCreated",
        "kind": "fork",
        "title": "Your agent key",
        "message": "Septena shows this key only once. Paste it into your script or agent. To stop the agent, disconnect it in this list.",
        "confirmTitle": "Copy Key",
        "options": [],
        "featureId": "agents.connector"
      },
      {
        "id": "agentReplaces",
        "kind": "fork",
        "title": "Replaces",
        "message": "If this agent takes the place of one you connected before, pick it. That agent stops working.",
        "options": [
          {
            "id": "none",
            "title": "Nothing, a new agent"
          },
          {
            "id": "agent",
            "title": "An agent below"
          }
        ],
        "featureId": "agents.connector"
      },
      {
        "id": "scanSignInCode",
        "kind": "fork",
        "title": "Scan a sign-in code",
        "message": "Point the camera at the QR code on the other screen.",
        "confirmTitle": "Scan Code",
        "options": [],
        "featureId": "sync.backend"
      },
      {
        "id": "cameraUnavailable",
        "kind": "fork",
        "title": "Septena can’t use the camera",
        "message": "Allow camera access for Septena in Settings, or enter the code instead.",
        "options": [],
        "featureId": "sync.backend"
      }
    ],
