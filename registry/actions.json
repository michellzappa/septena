    "sidebar.area": [
      { "kind": "action", "id": "area.newProject" },
      { "kind": "divider" },
      { "kind": "action", "id": "area.rename" },
      { "kind": "action", "id": "area.delete" }
    ],
    "sidebar.project": [
      { "kind": "action", "id": "project.rename" },
      { "kind": "action", "id": "project.moveUp" },
      { "kind": "action", "id": "project.moveDown" },
      { "kind": "divider" },
      { "kind": "submenu", "id": "moveToArea", "title": "Move to Area", "icon": "action.move", "items": [{ "kind": "slot", "slot": "moveToAreaDestinations" }] },
      { "kind": "divider" },
      { "kind": "action", "id": "project.markDone" },
      { "kind": "action", "id": "project.cancel" },
      { "kind": "divider" },
      { "kind": "action", "id": "project.delete" }
    ],
    "sidebar.empty": [
      { "kind": "action", "id": "sidebar.newArea" },
      { "kind": "action", "id": "sidebar.newProject" }
    ],
    "project.heading": [
      { "kind": "action", "id": "section.rename" },
      { "kind": "divider" },
      { "kind": "action", "id": "section.delete" }
    ],
    "project.blankSpace": [
      { "kind": "action", "id": "section.new" }
    ],
    "notice.getStartedStep": [
      { "kind": "action", "id": "notice.openStep" },
      { "kind": "action", "id": "notice.toggleStep" },
      { "kind": "divider" },
      { "kind": "action", "id": "notice.hideGetStarted" }
    ]
