      "title": "Task list",
      "actionIds": [
        "task.editDetails",
        "task.toggleInfo",
        "task.copy",
        "task.duplicate",
        "task.toggleComplete",
        "task.cancel",
        "task.toggleToday",
        "task.when",
        "task.deadline",
        "task.move",
        "task.moveSuggested",
