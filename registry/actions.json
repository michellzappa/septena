        "icon": "action.complete",
        "items": [
          { "kind": "action", "id": "task.toggleComplete" },
          { "kind": "action", "id": "task.cancel" },
          { "kind": "divider" },
          { "kind": "action", "id": "task.delete" }
        ]
      },
      { "kind": "action", "id": "task.toggleToday" },
      {
