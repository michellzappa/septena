{
  "version": 1,
  "description": "Semantic design tokens shared across Apple, Web, Android, and Windows clients (docs/DesignSpec.md). OS-owned surfaces and accent stay semantic roles so every platform feels native.",
  "accentPolicy": "userAccentWithColorfulDefault",
  "fruitAccents": [
    { "id": "colorful",   "name": "Colorful",   "origin": "Default · Blue + semantic", "light": "#007AFF", "dark": "#0A84FF", "checkLight": "#FFFFFF", "checkDark": "#FFFFFF", "multicolor": true },
    { "id": "tamarillo",  "name": "Tamarillo",  "origin": "Andes · Crimson",           "light": "#D6333F", "dark": "#FF5C67", "checkLight": "#FFFFFF", "checkDark": "#FFFFFF", "multicolor": false },
    { "id": "persimmon",  "name": "Persimmon",  "origin": "East Asia · Vermilion",     "light": "#E05212", "dark": "#FF7738", "checkLight": "#FFFFFF", "checkDark": "#FFFFFF", "multicolor": false },
    { "id": "yuzu",       "name": "Yuzu",       "origin": "Japan · Citrus gold",       "light": "#C28500", "dark": "#F2BF2C", "checkLight": "#FFFFFF", "checkDark": "#141518", "multicolor": false },
    { "id": "carambola",  "name": "Carambola",  "origin": "SE Asia · Starfruit",       "light": "#5B8C00", "dark": "#9EE034", "checkLight": "#FFFFFF", "checkDark": "#141518", "multicolor": false },
    { "id": "haskap",     "name": "Haskap",     "origin": "Hokkaido · Honeyberry blue", "light": "#1D63DC", "dark": "#4E94FF", "checkLight": "#FFFFFF", "checkDark": "#FFFFFF", "multicolor": false },
    { "id": "acai",       "name": "Açaí",       "origin": "Amazon · Indigo",           "light": "#6544D6", "dark": "#9B82FF", "checkLight": "#FFFFFF", "checkDark": "#FFFFFF", "multicolor": false },
    { "id": "pitaya",     "name": "Pitaya",     "origin": "Mesoamerica · Dragonfruit", "light": "#D4266C", "dark": "#FF5C9B", "checkLight": "#FFFFFF", "checkDark": "#FFFFFF", "multicolor": false },
    { "id": "jabuticaba", "name": "Jabuticaba", "origin": "Brazil · Obsidian ink",     "light": "#27272E", "dark": "#E4E4EA", "checkLight": "#FFFFFF", "checkDark": "#141518", "multicolor": false }
  ],
  "textures": [
    { "id": "none",         "name": "Pure Canvas",   "tag": "Baseline" },
    { "id": "topography",   "name": "Topography",    "tag": "Height Map" },
    { "id": "fieldMatrix",  "name": "Field Matrix",  "tag": "Industrial" },
    { "id": "stippleDrift", "name": "Stipple Drift", "tag": "Print / Ink" },
    { "id": "ridges",       "name": "Ridge Lines",   "tag": "Elevation" },
    { "id": "washiPaper",   "name": "Washi Paper",   "tag": "Tactile" }
  ],
  "selection": {
    "emphasizedAlphaLight": 0.22,
    "emphasizedAlphaDark": 0.34,
    "unemphasizedAlphaLight": 0.10,
    "unemphasizedAlphaDark": 0.14,
    "chipSelectedFillOpacity": 0.22,
    "pointerHoverOpacity": 0.012
  },
  "colors": {
    "todayAccent": "#F5C721",
    "nextAccent": "#7C3AED",
    "overdueRed": "systemRed",
    "noticeWarning": "systemOrange",
    "convoNeedsYou": "systemYellow",
    "convoWorking": "systemBlue",
    "convoDone": "systemGreen",
    "convoWontDo": "secondaryLabel"
  },
  "accentPalette": [
    "#ef4444", "#f97316", "#f59e0b", "#eab308", "#84cc16", "#22c55e",
    "#10b981", "#14b8a6", "#06b6d4", "#0ea5e9", "#3b82f6", "#6366f1",
    "#8b5cf6", "#a855f7", "#ec4899", "#f43f5e"
  ],
  "radii": {
    "card": 22,
    "small": 6,
    "transientSurface": 12
  },
  "spacing": {
    "xs": 4,
    "sm": 8,
    "md": 12,
    "lg": 16,
    "pageGutter": 20,
    "pageTop": 12
  },
  "desktopColumn": {
    "marginFraction": 0.10,
    "minInset": 10,
    "maxInset": 220,
    "verticalInset": 48,
    "titleBarGap": 20
  },
  "textScale": {
    "defaultStep": 0,
    "steps": [
      { "step": -2, "id": "xSmall", "label": "Smallest", "factor": 0.85 },
      { "step": -1, "id": "small", "label": "Small", "factor": 0.92 },
      { "step": 0, "id": "normal", "label": "Medium", "factor": 1.0 },
      { "step": 1, "id": "large", "label": "Large", "factor": 1.10 },
      { "step": 2, "id": "xLarge", "label": "Largest", "factor": 1.20 }
    ]
  }
}
