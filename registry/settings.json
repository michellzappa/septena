            { "kind": "customSurface", "surface": "account_profile_editor", "label": "Your name", "ownsKeys": ["welcomeName"] }
          ]
        },
        {
          "id": "plan",
          "items": [
            { "kind": "pageLink", "page": "plus", "label": "Septena Plus", "icon": "settings.plus", "statusKey": "planStatus", "featureId": "sync.backend" }
          ]
        },
        {
          "id": "devices_access",
          "items": [
            { "kind": "pageLink", "page": "devices_access", "label": "Devices", "icon": "settings.devices", "featureId": "sync.backend" }
          ]
        },
        {
          "id": "sync",
          "header": "Sync",
          "items": [
            { "kind": "customSurface", "surface": "sync_account_status" }
