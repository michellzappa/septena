            { "kind": "customSurface", "surface": "delete_account", "visibility": "signedIn", "featureId": "account.delete" }
          ]
        }
      ]
    },
    {
      "id": "plus",
      "title": "Septena Plus",
      "icon": "settings.plus",
      "depth": 2,
      "featureId": "sync.backend",
      "sections": [
        {
          "id": "offer",
          "items": [
            { "kind": "customSurface", "surface": "plus_offer" }
          ]
        }
      ]
    },
    {
