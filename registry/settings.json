    {
      "id": "claude_pairing",
      "title": "Connect Claude",
      "icon": "settings.claude",
      "depth": 1,
      "featureId": "agents.connector",
      "sections": [
        {
          "id": "connector",
          "header": "Connect Claude",
          "items": [
            { "kind": "customSurface", "surface": "claude_connector", "featureId": "agents.connector" }
          ]
        },
        {
          "id": "agent_tools",
          "header": "Agent tools",
          "footer": "The brief that teaches a model how to use your tasks through the connection (tools, conventions, and examples).",
          "items": [
            { "kind": "customSurface", "surface": "mcp_skills", "label": "MCP Skills", "icon": "settings.skills", "featureId": "agents.connector" }
          ]
        }
      ]
    },
    {
      "id": "ai_preferences",
      "title": "AI Preferences",
      "icon": "settings.ai_agents",
      "depth": 1,
      "featureId": "ai.reach-dial",
      "sections": [
        {
          "id": "on_device",
          "header": "AI on this device",
          "platforms": ["ios", "ipados", "macos"],
          "items": [
            { "kind": "customSurface", "surface": "apple_intelligence_status", "label": "Apple Intelligence", "platforms": ["ios", "ipados", "macos"], "featureId": "ai.reach-dial" }
          ]
        },
        {
          "id": "reach",
          "header": "Where AI runs",
          "footer": "Septena never runs AI on your data and never reads it. The intelligence is your own (Apple on-device, Private Cloud Compute, or your Claude). This only sets where requests may run.",
          "items": [
            { "kind": "setting", "key": "aiMode", "label": "AI Mode" }
          ]
        },
        {
          "id": "explainer",
          "items": [
            { "kind": "customSurface", "surface": "ai_explainer", "label": "How AI helps with your tasks", "icon": "settings.about" }
          ]
        }
      ]
    },
    {
      "id": "calendar",
      "title": "Calendar",
      "icon": "settings.calendar",
      "depth": 1,
      "featureId": "calendar.events",
      "sections": [
        {
          "id": "calendars",
          "items": [
            {
              "kind": "customSurface",
              "surface": "calendar_detail",
              "ownsKeys": ["tasksShowCalendarEvents", "calendarHiddenTitles"],
              "featureId": "calendar.events"
            }
          ]
        }
      ]
