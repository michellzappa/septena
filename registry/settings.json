{
  "version": 2,
  "description": "Canonical Septena task-app settings: synced keys (backend SETTING_VALUES + Swift SeptaskSyncedSettings), device-local keys/defaults, and new-user-first progressive-disclosure taxonomy (docs/SETTINGS_UX_SPEC.md).",
  "keys": {
    "welcomeName": {
      "scope": "synced",
      "storageKey": "septena.homepage.welcomeName",
      "type": "string",
      "maxLength": 200,
      "default": "",
      "platforms": ["ios", "ipados", "macos", "web", "android", "windows"],
      "featureId": "sync.backend"
    },
    "telemetryLevel": {
      "scope": "synced",
      "storageKey": "septena.privacy.telemetryLevel",
      "type": "enum",
      "enum": "telemetryLevel",
      "default": "balanced",
      "platforms": ["ios", "ipados", "macos", "web", "android", "windows"],
      "featureId": "settings.display"
    },
    "calendarHiddenTitles": {
      "scope": "synced",
      "type": "string[]",
      "maxItems": 500,
      "itemMaxLength": 500,
      "default": [],
      "platforms": ["ios", "ipados", "macos", "web", "android", "windows"],
      "featureId": "calendar.events"
    },
    "rolledInDismissedOn": {
      "scope": "synced",
      "storageKey": "septena.newTodos.dismissedDate",
      "type": "string",
      "format": "day",
      "default": null,
      "ui": false,
      "platforms": ["ios", "ipados", "macos", "web", "android", "windows"],
      "featureId": "lists.today"
    },
    "homeTimezone": {
      "scope": "synced",
      "type": "string",
      "maxLength": 64,
      "default": null,
      "ui": false,
      "platforms": ["ios", "ipados", "macos", "web", "android", "windows"],
      "featureId": "sync.backend"
    },
    "agentsPaused": {
      "scope": "synced",
      "type": "bool",
      "default": false,
      "platforms": ["ios", "ipados", "macos", "web", "android", "windows"],
      "featureId": "agents.stop-pause"
    },
    "getStartedDismissed": {
      "scope": "synced",
      "type": "bool",
      "default": false,
      "ui": false,
      "platforms": ["ios", "ipados", "macos", "web", "android", "windows"],
      "featureId": "lists.today"
    },
    "getStartedSteps": {
      "scope": "synced",
      "type": "string[]",
      "maxItems": 32,
      "itemMaxLength": 64,
      "default": [],
      "ui": false,
      "platforms": ["ios", "ipados", "macos", "web", "android", "windows"],
      "featureId": "lists.today"
    },
    "upsellsSeen": {
      "scope": "synced",
      "type": "string[]",
      "maxItems": 32,
      "itemMaxLength": 64,
      "default": [],
      "ui": false,
      "platforms": ["ios", "ipados", "macos", "web", "android", "windows"],
      "featureId": "sync.backend"
    },
    "onboardedAt": {
      "scope": "synced",
      "type": "string",
      "format": "stamp",
      "default": null,
      "ui": false,
      "platforms": ["ios", "ipados", "macos", "web", "android", "windows"],
      "featureId": "onboarding.first-run"
    },
    "accentColor": {
      "scope": "synced",
      "storageKey": "septena.appearance.accentColor",
      "type": "enum",
      "enum": "accentColor",
      "default": "colorful",
      "ui": false,
      "platforms": ["ios", "ipados", "macos", "web", "android", "windows"],
      "featureId": "settings.display"
    },
    "canvasTexture": {
      "scope": "synced",
      "storageKey": "septena.appearance.canvasTexture",
      "type": "enum",
      "enum": "canvasTexture",
      "default": "none",
      "ui": false,
      "platforms": ["ios", "ipados", "macos", "web", "android", "windows"],
      "featureId": "settings.display"
    },
    "textureIntensity": {
      "scope": "synced",
      "storageKey": "septena.appearance.textureIntensity",
      "type": "int",
      "min": 15,
      "max": 100,
      "default": 55,
      "ui": false,
      "platforms": ["ios", "ipados", "macos", "web", "android", "windows"],
      "featureId": "settings.display"
    },
    "textureMotion": {
      "scope": "synced",
      "storageKey": "septena.appearance.textureMotion",
      "type": "enum",
      "enum": "textureMotion",
      "default": "still",
      "ui": false,
      "platforms": ["ios", "ipados", "macos", "web", "android", "windows"],
      "featureId": "settings.display"
    },
    "smartListOrder": {
      "scope": "synced",
      "storageKey": "septena.sidebar.smartListOrder",
      "type": "string[]",
      "maxItems": 32,
      "itemMaxLength": 64,
      "default": [],
      "platforms": ["ios", "ipados", "macos", "web", "android", "windows"],
      "featureId": "settings.display"
    },
    "smartListHidden": {
      "scope": "synced",
      "storageKey": "septena.sidebar.smartListHidden",
      "type": "string[]",
      "maxItems": 32,
      "itemMaxLength": 64,
      "default": [],
      "platforms": ["ios", "ipados", "macos", "web", "android", "windows"],
      "featureId": "settings.display"
    },
    "smartListPlacement": {
      "scope": "synced",
      "storageKey": "septena.sidebar.smartListPlacement",
      "type": "record",
      "maxEntries": 32,
      "keyMaxLength": 64,
      "values": ["top", "bottom"],
      "default": {},
      "platforms": ["ios", "ipados", "macos", "web", "android", "windows"],
      "featureId": "settings.display"
    },
    "appearanceMode": {
      "scope": "device",
      "storageKey": "septena.appearance.mode",
      "type": "enum",
      "enum": "appearanceMode",
      "default": "system",
      "ui": false,
      "platforms": ["ios", "ipados", "macos", "web", "android", "windows"],
      "featureId": "settings.display"
    },
    "syncTheme": {
      "scope": "device",
      "storageKey": "septena.appearance.syncTheme",
      "type": "bool",
      "default": true,
      "ui": false,
      "platforms": ["ios", "ipados", "macos", "web", "android", "windows"],
      "featureId": "settings.display"
    },
    "appIconFinish": {
      "scope": "device",
      "storageKey": "septena.appearance.appIconFinish",
      "type": "enum",
      "enum": "appIconFinish",
      "default": "obsidian",
      "ui": false,
      "platforms": ["ios", "ipados", "macos"],
      "featureId": "settings.display"
    },
    "todayShowCompleted": {
      "scope": "device",
      "storageKey": "septena.today.showCompleted",
      "type": "bool",
      "default": true,
      "platforms": ["ios", "ipados", "macos", "web", "android", "windows"],
      "featureId": "lists.today"
    },
    "todayGroupByList": {
      "scope": "device",
      "storageKey": "septena.today.groupByList",
      "type": "bool",
      "default": true,
      "platforms": ["ios", "ipados", "macos", "web", "android", "windows"],
      "featureId": "lists.today"
    },
    "tasksShowAging": {
      "scope": "device",
      "storageKey": "septena.tasks.showAging",
      "type": "bool",
      "default": true,
      "platforms": ["ios", "ipados", "macos", "web", "android", "windows"],
      "featureId": "task.aging"
    },
    "tasksShowFaded": {
      "scope": "device",
      "storageKey": "septena.tasks.showFaded",
      "type": "bool",
      "default": true,
      "platforms": ["ios", "ipados", "macos", "web", "android", "windows"],
      "featureId": "task.aging"
    },
    "tasksTitleLines": {
      "scope": "device",
      "storageKey": "septena.tasks.titleLines",
      "type": "int",
      "min": 1,
      "max": 3,
      "default": 2,
      "options": [
        { "value": "1", "title": "One" },
        { "value": "2", "title": "Two" },
        { "value": "3", "title": "Three" }
      ],
      "platforms": ["ios", "ipados", "android"],
      "featureId": "settings.display"
    },
    "tasksFilingSuggestions": {
      "scope": "device",
      "storageKey": "septena.tasks.filingSuggestions",
      "type": "bool",
      "default": true,
      "platforms": ["ios", "ipados", "macos", "android", "windows"],
      "featureId": "edit.filing-suggestion"
    },
    "tasksShowCalendarEvents": {
      "scope": "device",
      "storageKey": "septena.tasks.showCalendarEvents",
      "type": "bool",
      "default": true,
      "platforms": ["ios", "ipados", "macos", "web", "android", "windows"],
      "featureId": "calendar.events"
    },
    "badgeShowOverdue": {
      "scope": "device",
      "storageKey": "septena.badge.showOverdue",
      "sharedAppGroup": true,
      "type": "bool",
      "default": false,
      "platforms": ["ios", "ipados", "macos", "android", "windows"],
      "featureId": "settings.display"
    },
    "loggingAnimationsEnabled": {
      "scope": "device",
      "storageKey": "septena.ui.loggingAnimations",
      "type": "bool",
      "default": true,
      "platforms": ["ios", "ipados", "macos", "web", "android", "windows"],
      "featureId": "settings.display"
    },
    "textSizeStep": {
      "scope": "device",
      "storageKey": "septena.display.textSizeStep",
      "type": "int",
      "min": -2,
      "max": 2,
      "default": 0,
      "platforms": ["ios", "ipados", "macos", "web", "android", "windows"],
      "featureId": "settings.display"
    },
    "sidebarCounts": {
      "scope": "device",
      "storageKey": "septena.septask.sidebarCounts",
      "type": "bool",
      "default": true,
      "ui": false,
      "platforms": ["macos", "web", "windows"],
      "featureId": "settings.display"
    },
    "aiMode": {
      "scope": "device",
      "storageKey": "septena.ai.mode",
      "type": "enum",
      "values": ["onDeviceOnly", "auto", "useMyClaude"],
      "default": "auto",
      "options": [
        { "value": "onDeviceOnly", "title": "On-device only" },
        { "value": "auto", "title": "Automatic" },
        { "value": "useMyClaude", "title": "Use my Claude" }
      ],
      "platforms": ["ios", "ipados", "macos", "web", "android", "windows"],
      "featureId": "ai.reach-dial"
    },
    "diagnosticsEnabled": {
      "ui": false,
      "scope": "device",
      "storageKey": "septask.diagnostics.enabled",
      "type": "bool",
      "default": false,
      "platforms": ["ios", "ipados", "macos", "web", "android", "windows"],
      "featureId": "settings.display"
    },
    "showModelLabels": {
      "ui": false,
      "scope": "device",
      "storageKey": "septena.ai.showModelTags",
      "type": "bool",
      "default": true,
      "platforms": ["ios", "ipados", "macos"],
      "featureId": "ai.reach-dial"
    },
    "pccRoutingEnabled": {
      "ui": false,
      "scope": "device",
      "storageKey": "septena.ai.pccRoutingEnabled",
      "type": "bool",
      "default": false,
      "platforms": ["ios", "ipados", "macos"],
      "featureId": "ai.reach-dial"
    },
    "pccReasoning": {
      "ui": false,
      "scope": "device",
      "storageKey": "septena.ai.pccReasoning",
      "type": "enum",
      "values": ["light", "balanced", "thorough"],
      "default": "balanced",
      "options": [
        { "value": "light", "title": "Light" },
        { "value": "balanced", "title": "Balanced" },
        { "value": "thorough", "title": "Thorough" }
      ],
      "platforms": ["ios", "ipados", "macos"],
      "featureId": "ai.reach-dial"
    }
  },
  "desktopTabs": [
    {
      "id": "account",
      "title": "Account",
      "icon": "settings.account",
      "group": "identity",
      "featureId": "sync.backend"
    },
    {
      "id": "general",
      "title": "General",
      "icon": "settings.general",
      "group": "main",
      "paletteSlot": 0,
      "featureId": "lists.today"
    },
    {
      "id": "ai_agents",
      "title": "AI & Agents",
      "icon": "settings.ai_agents",
      "group": "main",
      "paletteSlot": 4,
      "featureId": "ai.reach-dial"
    },
    {
      "id": "connections_data",
      "title": "Connections",
      "icon": "settings.connections",
      "group": "main",
      "paletteSlot": 5,
      "featureId": "sync.backend"
    },
    {
      "id": "privacy",
      "title": "Privacy & Data",
      "icon": "settings.privacy",
      "group": "main",
      "paletteSlot": 6,
      "featureId": "settings.display"
    },
    {
      "id": "about",
      "title": "About",
      "icon": "settings.about",
      "group": "about",
      "featureId": "settings.display"
    }
  ],
  "rootGroups": [
    {
      "id": "account_root",
      "mobilePresentation": "card",
      "desktopTab": "account",
      "items": [
        {
          "kind": "pageLink",
          "page": "account",
          "surface": "account_profile_card",
          "label": "Account",
          "icon": "settings.account",
          "statusKey": "syncStatus",
          "featureId": "sync.backend"
        }
      ]
    },
    {
      "id": "ai_agents_root",
      "header": "AI & Agents",
      "mobilePresentation": "inline",
      "desktopTab": "ai_agents",
      "items": [
        {
          "kind": "pageLink",
          "page": "claude_pairing",
          "label": "Connect Claude",
          "icon": "settings.claude",
          "statusKey": "claudeStatus",
          "desktopInline": true,
          "featureId": "agents.connector"
        },
        {
          "kind": "pageLink",
          "page": "agents",
          "label": "Agents",
          "icon": "settings.agents",
          "statusKey": "agentsStatus",
          "desktopInline": true,
          "visibility": "signedIn",
          "featureId": "agents.connector"
        },
        {
          "kind": "setting",
          "key": "agentsPaused",
          "label": "Pause all agents",
          "detail": "While paused, no agent can start or work on a task.",
          "visibility": "signedIn"
        },
        {
          "kind": "pageLink",
          "page": "ai_preferences",
          "label": "AI Preferences",
          "icon": "settings.ai_agents",
          "statusKey": "aiMode",
          "desktopInline": true,
          "featureId": "ai.reach-dial"
        }
      ]
    },
    {
      "id": "connections_data_root",
      "header": "Connections",
      "mobilePresentation": "inline",
      "desktopTab": "connections_data",
      "items": [
        {
          "kind": "pageLink",
          "page": "calendar",
          "label": "Calendar",
          "icon": "settings.calendar",
          "statusKey": "calendarStatus",
          "featureId": "calendar.events"
        },
        {
          "kind": "pageLink",
          "page": "reminders",
          "label": "Reminders",
          "icon": "settings.reminders",
          "statusKey": "remindersStatus",
          "platforms": ["ios", "ipados", "macos"],
          "featureId": "import.reminders"
        }
      ]
    },
    {
      "id": "lists_root",
      "header": "Lists",
      "mobilePresentation": "inline",
      "desktopTab": "general",
      "items": [
        {
          "kind": "pageLink",
          "page": "smart_lists",
          "label": "Smart Lists",
          "icon": "list.today",
          "featureId": "settings.display"
        },
        {
          "kind": "setting",
          "key": "todayGroupByList",
          "label": "Group Today by list",
          "detail": "When off, tasks appear in one list with their project or area underneath."
        },
        {
          "kind": "setting",
          "key": "todayShowCompleted",
          "label": "Show completed tasks"
        },
        {
          "kind": "setting",
          "key": "tasksShowAging",
          "label": "Fade inactive tasks",
          "detail": "Tasks without activity for 14 days fade out and move to Faded."
        },
        {
          "kind": "setting",
          "key": "tasksShowFaded",
          "label": "Show faded tasks",
          "detail": "Show faded tasks in projects and areas."
        },
        {
          "kind": "setting",
          "key": "tasksFilingSuggestions",
          "label": "Suggest where to file",
          "detail": "Learn where you usually file similar tasks."
        },
        {
          "kind": "setting",
          "key": "badgeShowOverdue",
          "label": "Overdue app icon badge"
        }
      ]
    },
    {
      "id": "appearance_root",
      "mobilePresentation": "inline",
      "desktopTab": "general",
      "items": [
        {
          "kind": "pageLink",
          "page": "appearance",
          "label": "Appearance",
          "icon": "settings.appearance",
          "desktopInline": true,
          "featureId": "settings.display"
        }
      ]
    },
    {
      "id": "meta_root",
      "mobilePresentation": "inline",
      "desktopTab": null,
      "items": [
        {
          "kind": "pageLink",
          "page": "privacy",
          "label": "Privacy & Data",
          "icon": "settings.privacy",
          "featureId": "settings.display"
        },
        {
          "kind": "pageLink",
          "page": "about",
          "label": "About",
          "icon": "settings.about",
          "featureId": "settings.display"
        }
      ]
    }
  ],
  "pages": [
    {
      "id": "devices_access",
      "title": "Devices",
      "icon": "settings.devices",
      "depth": 2,
      "featureId": "sync.backend",
      "sections": [
        {
          "id": "devices",
          "header": "Devices",
          "footer": "Each app you signed in to. A device you sign out stops syncing within the hour.",
          "items": [
            { "kind": "customSurface", "surface": "access_devices", "featureId": "sync.backend" }
          ]
        },
        {
          "id": "watch",
          "platforms": ["ios"],
          "items": [
            { "kind": "customSurface", "surface": "apple_watch", "platforms": ["ios"], "featureId": "sync.backend" }
          ]
        }
      ]
    },
    {
      "id": "appearance",
      "title": "Appearance",
      "icon": "settings.appearance",
      "depth": 1,
      "featureId": "settings.display",
      "sections": [
        {
          "id": "appearance",
          "items": [
            {
              "kind": "customSurface",
              "surface": "accent_color",
              "label": "Accent",
              "icon": "settings.appearance",
              "featureId": "settings.display"
            },
            {
              "kind": "setting",
              "key": "textSizeStep",
              "label": "Text Size"
            },
            {
              "kind": "setting",
              "key": "tasksTitleLines",
              "label": "Title lines",
              "platforms": ["ios", "ipados", "android"]
            },
            {
              "kind": "setting",
              "key": "loggingAnimationsEnabled",
              "label": "Completion animations"
            }
          ]
        }
      ]
    },
    {
      "id": "account",
      "title": "Account",
      "icon": "settings.account",
      "depth": 1,
      "featureId": "sync.backend",
      "sections": [
        {
          "id": "profile",
          "footer": "Your name stays on this device, and syncs when you sign in.",
