{
  "version": 2,
  "description": "Canonical Septena task-app settings: synced keys (backend SETTING_VALUES + Swift SeptaskSyncedSettings), device-local keys/defaults, and new-user-first progressive-disclosure taxonomy (docs/SETTINGS_UX_SPEC.md).",
  "keys": {
    "welcomeName": {
      "scope": "synced",
      "storageKey": "septena.homepage.welcomeName",
      "type": "string",
      "maxLength": 200,
      "default": "",
      "platforms": ["ios", "ipados", "macos", "web", "android", "windows"],
      "featureId": "sync.backend"
    },
    "telemetryLevel": {
      "scope": "synced",
      "storageKey": "septena.privacy.telemetryLevel",
      "type": "enum",
      "enum": "telemetryLevel",
      "default": "balanced",
      "platforms": ["ios", "ipados", "macos", "web", "android", "windows"],
      "featureId": "settings.display"
    },
    "calendarHiddenTitles": {
      "scope": "synced",
      "type": "string[]",
      "maxItems": 500,
      "itemMaxLength": 500,
      "default": [],
      "platforms": ["ios", "ipados", "macos", "web", "android", "windows"],
      "featureId": "calendar.events"
    },
    "rolledInDismissedOn": {
      "scope": "synced",
      "storageKey": "septena.newTodos.dismissedDate",
      "type": "string",
      "format": "day",
      "default": null,
      "ui": false,
      "platforms": ["ios", "ipados", "macos", "web", "android", "windows"],
      "featureId": "lists.today"
    },
    "homeTimezone": {
      "scope": "synced",
      "type": "string",
      "maxLength": 64,
      "default": null,
      "ui": false,
      "platforms": ["ios", "ipados", "macos", "web", "android", "windows"],
      "featureId": "sync.backend"
    },
    "agentsPaused": {
      "scope": "synced",
      "type": "bool",
      "default": false,
      "platforms": ["ios", "ipados", "macos", "web", "android", "windows"],
      "featureId": "agents.stop-pause"
    },
    "getStartedDismissed": {
      "scope": "synced",
      "type": "bool",
      "default": false,
      "ui": false,
      "platforms": ["ios", "ipados", "macos", "web", "android", "windows"],
      "featureId": "lists.today"
    },
    "getStartedSteps": {
      "scope": "synced",
      "type": "string[]",
      "maxItems": 32,
      "itemMaxLength": 64,
      "default": [],
      "ui": false,
      "platforms": ["ios", "ipados", "macos", "web", "android", "windows"],
      "featureId": "lists.today"
    },
    "upsellsSeen": {
      "scope": "synced",
      "type": "string[]",
      "maxItems": 32,
      "itemMaxLength": 64,
      "default": [],
      "ui": false,
      "platforms": ["ios", "ipados", "macos", "web", "android", "windows"],
      "featureId": "sync.backend"
    },
    "onboardedAt": {
      "scope": "synced",
      "type": "string",
      "format": "stamp",
      "default": null,
      "ui": false,
      "platforms": ["ios", "ipados", "macos", "web", "android", "windows"],
      "featureId": "onboarding.first-run"
    },
    "accentColor": {
      "scope": "synced",
      "storageKey": "septena.appearance.accentColor",
      "type": "enum",
      "enum": "accentColor",
      "default": "colorful",
      "ui": false,
      "platforms": ["ios", "ipados", "macos", "web", "android", "windows"],
      "featureId": "appearance.accents"
    },
    "canvasTexture": {
      "scope": "synced",
      "storageKey": "septena.appearance.canvasTexture",
      "type": "enum",
      "enum": "canvasTexture",
      "default": "none",
      "ui": false,
      "platforms": ["ios", "ipados", "macos", "web", "android", "windows"],
      "featureId": "appearance.textures"
    },
    "textureIntensity": {
      "scope": "synced",
      "storageKey": "septena.appearance.textureIntensity",
      "type": "int",
      "min": 15,
      "max": 100,
      "default": 55,
      "ui": false,
      "platforms": ["ios", "ipados", "macos", "web", "android", "windows"],
      "featureId": "appearance.textures"
    },
    "textureMotion": {
      "scope": "synced",
      "storageKey": "septena.appearance.textureMotion",
      "type": "enum",
      "enum": "textureMotion",
      "default": "still",
      "ui": false,
      "platforms": ["ios", "ipados", "macos", "web", "android", "windows"],
      "featureId": "appearance.textures"
    },
    "smartListOrder": {
      "scope": "synced",
      "storageKey": "septena.sidebar.smartListOrder",
      "type": "string[]",
      "maxItems": 32,
      "itemMaxLength": 64,
      "default": [],
      "platforms": ["ios", "ipados", "macos", "web", "android", "windows"],
      "featureId": "settings.display"
    },
    "smartListHidden": {
      "scope": "synced",
      "storageKey": "septena.sidebar.smartListHidden",
      "type": "string[]",
      "maxItems": 32,
      "itemMaxLength": 64,
      "default": [],
      "platforms": ["ios", "ipados", "macos", "web", "android", "windows"],
      "featureId": "settings.display"
    },
    "smartListPlacement": {
      "scope": "synced",
      "storageKey": "septena.sidebar.smartListPlacement",
      "type": "record",
      "maxEntries": 32,
      "keyMaxLength": 64,
      "values": ["top", "bottom"],
      "default": {},
      "platforms": ["ios", "ipados", "macos", "web", "android", "windows"],
      "featureId": "settings.display"
    },
    "appearanceMode": {
      "scope": "device",
      "storageKey": "septena.appearance.mode",
      "type": "enum",
      "enum": "appearanceMode",
      "default": "system",
      "options": [
        { "value": "system", "title": "System" },
        { "value": "light", "title": "Light" },
        { "value": "dark", "title": "Dark" }
      ],
      "ui": false,
      "platforms": ["ios", "ipados", "macos", "web", "android", "windows"],
      "featureId": "appearance.mode"
    },
    "syncTheme": {
      "scope": "device",
      "storageKey": "septena.appearance.syncTheme",
      "type": "bool",
      "default": true,
      "ui": false,
      "platforms": ["ios", "ipados", "macos", "web", "android", "windows"],
      "featureId": "appearance.mode"
    },
    "appIconFinish": {
      "scope": "device",
      "storageKey": "septena.appearance.appIconFinish",
      "type": "enum",
      "enum": "appIconFinish",
      "default": "obsidian",
      "ui": false,
      "platforms": ["ios", "ipados", "macos"],
      "featureId": "settings.display"
    },
    "todayShowCompleted": {
      "scope": "device",
      "storageKey": "septena.today.showCompleted",
      "type": "bool",
      "default": true,
      "platforms": ["ios", "ipados", "macos", "web", "android", "windows"],
      "featureId": "lists.today"
    },
    "todayGroupByList": {
      "scope": "device",
      "storageKey": "septena.today.groupByList",
      "type": "bool",
      "default": true,
      "platforms": ["ios", "ipados", "macos", "web", "android", "windows"],
      "featureId": "lists.today"
    },
    "tasksShowAging": {
      "scope": "device",
      "storageKey": "septena.tasks.showAging",
      "type": "bool",
      "default": true,
      "platforms": ["ios", "ipados", "macos", "web", "android", "windows"],
      "featureId": "task.aging"
    },
    "tasksShowFaded": {
      "scope": "device",
      "storageKey": "septena.tasks.showFaded",
      "type": "bool",
      "default": true,
      "platforms": ["ios", "ipados", "macos", "web", "android", "windows"],
      "featureId": "task.aging"
    },
    "tasksTitleLines": {
      "scope": "device",
      "storageKey": "septena.tasks.titleLines",
      "type": "int",
      "min": 1,
      "max": 3,
      "default": 2,
      "options": [
        { "value": "1", "title": "One" },
        { "value": "2", "title": "Two" },
        { "value": "3", "title": "Three" }
      ],
      "platforms": ["ios", "ipados", "android"],
      "featureId": "settings.display"
    },
    "tasksFilingSuggestions": {
      "scope": "device",
      "storageKey": "septena.tasks.filingSuggestions",
      "type": "bool",
      "default": true,
      "platforms": ["ios", "ipados", "macos", "android", "windows"],
      "featureId": "edit.filing-suggestion"
    },
    "tasksShowCalendarEvents": {
      "scope": "device",
      "storageKey": "septena.tasks.showCalendarEvents",
      "type": "bool",
      "default": true,
      "platforms": ["ios", "ipados", "macos", "web", "android", "windows"],
      "featureId": "calendar.events"
    },
    "badgeShowOverdue": {
      "scope": "device",
      "storageKey": "septena.badge.showOverdue",
      "sharedAppGroup": true,
      "type": "bool",
      "default": false,
      "platforms": ["ios", "ipados", "macos", "android", "windows"],
      "featureId": "settings.display"
    },
    "loggingAnimationsEnabled": {
      "scope": "device",
      "storageKey": "septena.ui.loggingAnimations",
      "type": "bool",
      "default": true,
      "platforms": ["ios", "ipados", "macos", "web", "android", "windows"],
      "featureId": "settings.display"
    },
    "textSizeStep": {
      "scope": "device",
      "storageKey": "septena.display.textSizeStep",
      "type": "int",
      "min": -2,
      "max": 2,
      "default": 0,
      "platforms": ["ios", "ipados", "macos", "web", "android", "windows"],
      "featureId": "appearance.text-size"
    },
    "sidebarCounts": {
      "scope": "device",
      "storageKey": "septena.septask.sidebarCounts",
      "type": "bool",
      "default": true,
      "ui": false,
      "platforms": ["macos", "web", "windows"],
      "featureId": "settings.display"
    },
    "aiMode": {
      "scope": "device",
      "storageKey": "septena.ai.mode",
      "type": "enum",
      "values": ["onDeviceOnly", "auto", "useMyClaude"],
      "default": "auto",
      "options": [
        { "value": "onDeviceOnly", "title": "On-device only" },
        { "value": "auto", "title": "Automatic" },
        { "value": "useMyClaude", "title": "Use my Claude" }
      ],
      "platforms": ["ios", "ipados", "macos", "web", "android", "windows"],
      "featureId": "ai.reach-dial"
    },
    "diagnosticsEnabled": {
      "ui": false,
      "scope": "device",
      "storageKey": "septask.diagnostics.enabled",
      "type": "bool",
      "default": false,
      "platforms": ["ios", "ipados", "macos", "web", "android", "windows"],
      "featureId": "settings.display"
    },
    "showModelLabels": {
      "ui": false,
      "scope": "device",
      "storageKey": "septena.ai.showModelTags",
      "type": "bool",
      "default": true,
      "platforms": ["ios", "ipados", "macos"],
      "featureId": "ai.reach-dial"
    },
    "pccRoutingEnabled": {
      "ui": false,
      "scope": "device",
      "storageKey": "septena.ai.pccRoutingEnabled",
      "type": "bool",
      "default": false,
      "platforms": ["ios", "ipados", "macos"],
      "featureId": "ai.reach-dial"
    },
    "pccReasoning": {
      "ui": false,
      "scope": "device",
      "storageKey": "septena.ai.pccReasoning",
      "type": "enum",
      "values": ["light", "balanced", "thorough"],
      "default": "balanced",
      "options": [
        { "value": "light", "title": "Light" },
        { "value": "balanced", "title": "Balanced" },
        { "value": "thorough", "title": "Thorough" }
      ],
      "platforms": ["ios", "ipados", "macos"],
      "featureId": "ai.reach-dial"
    }
  },
