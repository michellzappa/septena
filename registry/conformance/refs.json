{
  "version": 1,
  "description": "Golden conformance vectors for the task reference key grammar (docs/TASK_REFERENCES_SPEC.md sections 3, 4 and 6.1, ADR 0031) in the shared core. `input` of findIssueRefs is the text. An expected `error` is the core's exact reason; it never holds the input.",
  "parseRef": [
    {"name": "message link", "input": "message://%3CCAF%2Babc.DEF@Mail.Example.COM%3E", "expected": {"key": "email:CAF+abc.DEF@mail.example.com", "kind": "email", "id": "CAF+abc.DEF@mail.example.com", "rawId": "CAF+abc.DEF@Mail.Example.COM", "url": null}},
    {"name": "message link without slashes", "input": "message:%3Ca%40B.com%3E", "expected": {"key": "email:a@b.com", "kind": "email", "id": "a@b.com", "rawId": "a@B.com", "url": null}},
    {"name": "message link with plain brackets", "input": "message://<a@b.com>", "expected": {"key": "email:a@b.com", "kind": "email", "id": "a@b.com", "rawId": "a@b.com", "url": null}},
    {"name": "message link, upper-case scheme", "input": "MESSAGE://%3ca@b.com%3e", "expected": {"key": "email:a@b.com", "kind": "email", "id": "a@b.com", "rawId": "a@b.com", "url": null}},
    {"name": "message link keeps a stray percent sign", "input": "message://%3Ca%zz@b.com%3E", "expected": {"key": "email:a%zz@b.com", "kind": "email", "id": "a%zz@b.com", "rawId": "a%zz@b.com", "url": null}},
    {"name": "message link that is not UTF-8", "input": "message://%3C%FF@b.com%3E", "expected": {"error": "The message link is not valid"}},
    {"name": "empty message link", "input": "message://", "expected": {"error": "The reference id is empty"}},
    {"name": "email key, folded and with brackets", "input": "email: <A.b\r\n @X.Org> ", "expected": {"key": "email:A.b@x.org", "kind": "email", "id": "A.b@x.org", "rawId": "A.b@X.Org", "url": null}},
    {"name": "email id with two at signs lowercases after the last", "input": "email:A@B@C.COM", "expected": {"key": "email:A@B@c.com", "kind": "email", "id": "A@B@c.com", "rawId": "A@B@C.COM", "url": null}},
    {"name": "email id without a domain", "input": "email:ABC", "expected": {"key": "email:ABC", "kind": "email", "id": "ABC", "rawId": "ABC", "url": null}},
    {"name": "thread key", "input": "thread:<Root@X.org>", "expected": {"key": "thread:Root@x.org", "kind": "thread", "id": "Root@x.org", "rawId": "Root@X.org", "url": null}},
    {"name": "empty email key", "input": "email:<>", "expected": {"error": "The reference id is empty"}},
    {"name": "upper-case kind", "input": "EMAIL:a@b.com", "expected": {"key": "email:a@b.com", "kind": "email", "id": "a@b.com", "rawId": "a@b.com", "url": null}},
    {"name": "event", "input": "event:ABC-123@google.com", "expected": {"key": "event:ABC-123@google.com", "kind": "event", "id": "ABC-123@google.com", "rawId": "ABC-123@google.com", "url": null}},
    {"name": "event occurrence", "input": "event:abc|20261124T100000Z", "expected": {"key": "event:abc|20261124T100000Z", "kind": "event", "id": "abc|20261124T100000Z", "rawId": "abc|20261124T100000Z", "url": null}},
    {"name": "all-day event occurrence", "input": "event:abc|20261124", "expected": {"key": "event:abc|20261124", "kind": "event", "id": "abc|20261124", "rawId": "abc|20261124", "url": null}},
    {"name": "event occurrence in lower case", "input": "event:abc|20261124t100000z", "expected": {"key": "event:abc|20261124T100000Z", "kind": "event", "id": "abc|20261124T100000Z", "rawId": "abc|20261124t100000z", "url": null}},
    {"name": "event uid in normal form stays", "input": "event:a%25b%7Cc", "expected": {"key": "event:a%25b%7Cc", "kind": "event", "id": "a%25b%7Cc", "rawId": "a%25b%7Cc", "url": null}},
    {"name": "event uid with a bare percent sign", "input": "event:a%41b", "expected": {"key": "event:a%2541b", "kind": "event", "id": "a%2541b", "rawId": "a%41b", "url": null}},
    {"name": "event uid with a lower-case escape", "input": "event:a%7cb", "expected": {"key": "event:a%7Cb", "kind": "event", "id": "a%7Cb", "rawId": "a%7cb", "url": null}},
    {"name": "event occurrence in local time", "input": "event:abc|20261124T100000", "expected": {"error": "The recurrence id of the event is not valid"}},
    {"name": "event occurrence on a day that does not exist", "input": "event:abc|20260231", "expected": {"error": "The recurrence id of the event is not valid"}},
    {"name": "event occurrence at an hour that does not exist", "input": "event:abc|20261124T250000Z", "expected": {"error": "The recurrence id of the event is not valid"}},
    {"name": "event with two bars", "input": "event:a|b|20261124", "expected": {"error": "The recurrence id of the event is not valid"}},
    {"name": "event without a uid", "input": "event:|20261124", "expected": {"error": "The reference id is empty"}},
    {"name": "issue key", "input": "issue:MichellZappa/Septena#386", "expected": {"key": "issue:michellzappa/septena#386", "kind": "issue", "id": "michellzappa/septena#386", "rawId": "MichellZappa/Septena#386", "url": null}},
    {"name": "issue number with leading zeros", "input": "issue:a/b#007", "expected": {"key": "issue:a/b#7", "kind": "issue", "id": "a/b#7", "rawId": "a/b#007", "url": null}},
    {"name": "issue number zero", "input": "issue:a/b#0", "expected": {"error": "An issue key is owner/repo#number"}},
    {"name": "issue number with a sign", "input": "issue:a/b#+7", "expected": {"error": "An issue key is owner/repo#number"}},
    {"name": "issue without a repository", "input": "issue:a#7", "expected": {"error": "An issue key is owner/repo#number"}},
    {"name": "issue with a path in the repository", "input": "issue:a/b/c#7", "expected": {"error": "An issue key is owner/repo#number"}},
    {"name": "issue owner of dots", "input": "issue:../b#7", "expected": {"error": "An issue key is owner/repo#number"}},
    {"name": "GitHub issue URL", "input": "https://github.com/Acme/App/issues/7", "expected": {"key": "issue:acme/app#7", "kind": "issue", "id": "acme/app#7", "rawId": "Acme/App#7", "url": "https://github.com/Acme/App/issues/7"}},
    {"name": "GitHub pull request URL", "input": "https://github.com/Acme/App/pull/8", "expected": {"key": "issue:acme/app#8", "kind": "issue", "id": "acme/app#8", "rawId": "Acme/App#8", "url": "https://github.com/Acme/App/pull/8"}},
    {"name": "GitHub pull request files", "input": "https://www.GitHub.com/Acme/App/pull/8/files?w=1#diff", "expected": {"key": "issue:acme/app#8", "kind": "issue", "id": "acme/app#8", "rawId": "Acme/App#8", "url": "https://github.com/Acme/App/pull/8"}},
    {"name": "GitHub issue over http", "input": "http://github.com/a/b/issues/7/", "expected": {"key": "issue:a/b#7", "kind": "issue", "id": "a/b#7", "rawId": "a/b#7", "url": "https://github.com/a/b/issues/7"}},
    {"name": "GitHub repository page", "input": "https://github.com/Acme/App", "expected": {"key": "url:https://github.com/Acme/App", "kind": "url", "id": "https://github.com/Acme/App", "rawId": "https://github.com/Acme/App", "url": "https://github.com/Acme/App"}},
    {"name": "GitHub new issue page", "input": "https://github.com/a/b/issues/new", "expected": {"key": "url:https://github.com/a/b/issues/new", "kind": "url", "id": "https://github.com/a/b/issues/new", "rawId": "https://github.com/a/b/issues/new", "url": "https://github.com/a/b/issues/new"}},
    {"name": "GitHub on another port", "input": "https://github.com:8443/a/b/issues/7", "expected": {"key": "url:https://github.com:8443/a/b/issues/7", "kind": "url", "id": "https://github.com:8443/a/b/issues/7", "rawId": "https://github.com:8443/a/b/issues/7", "url": "https://github.com:8443/a/b/issues/7"}},
    {"name": "host that ends in github.com", "input": "https://notgithub.com/a/b/issues/7", "expected": {"key": "url:https://notgithub.com/a/b/issues/7", "kind": "url", "id": "https://notgithub.com/a/b/issues/7", "rawId": "https://notgithub.com/a/b/issues/7", "url": "https://notgithub.com/a/b/issues/7"}},
    {"name": "url key with a GitHub issue", "input": "url:https://github.com/a/b/issues/7", "expected": {"key": "issue:a/b#7", "kind": "issue", "id": "a/b#7", "rawId": "a/b#7", "url": "https://github.com/a/b/issues/7"}},
    {"name": "Septena task", "input": "task:abc234", "expected": {"key": "task:abc234", "kind": "task", "id": "abc234", "rawId": "abc234", "url": null}},
    {"name": "Septena recurring task", "input": "task:recur-27f6e5d56dadf4cc", "expected": {"key": "task:recur-27f6e5d56dadf4cc", "kind": "task", "id": "recur-27f6e5d56dadf4cc", "rawId": "recur-27f6e5d56dadf4cc", "url": null}},
    {"name": "Starlings task", "input": "task:Acme.Starlings.Work/T-1", "expected": {"key": "task:acme.starlings.work/T-1", "kind": "task", "id": "acme.starlings.work/T-1", "rawId": "Acme.Starlings.Work/T-1", "url": null}},
    {"name": "task id with a space", "input": "task:a b", "expected": {"error": "A task key is a task id or host/id"}},
    {"name": "Starlings task without an id", "input": "task:acme.starlings.work/", "expected": {"error": "A task key is a task id or host/id"}},
    {"name": "Starlings task with a path", "input": "task:acme.starlings.work/a/b", "expected": {"error": "A task key is a task id or host/id"}},
    {"name": "door", "input": "door:Acme.starlings.work|subject:project:p1", "expected": {"key": "door:acme.starlings.work|subject:project:p1", "kind": "door", "id": "acme.starlings.work|subject:project:p1", "rawId": "Acme.starlings.work|subject:project:p1", "url": null}},
    {"name": "door with a path", "input": "door:acme.starlings.work|document:/house/readme", "expected": {"key": "door:acme.starlings.work|document:/house/readme", "kind": "door", "id": "acme.starlings.work|document:/house/readme", "rawId": "acme.starlings.work|document:/house/readme", "url": null}},
    {"name": "door of an issue", "input": "door:acme.starlings.work|issue:Acme/App#7", "expected": {"key": "issue:acme/app#7", "kind": "issue", "id": "acme/app#7", "rawId": "Acme/App#7", "url": null}},
    {"name": "door of a task", "input": "door:Acme.starlings.work|task:T-1", "expected": {"key": "task:acme.starlings.work/T-1", "kind": "task", "id": "acme.starlings.work/T-1", "rawId": "Acme.starlings.work/T-1", "url": null}},
    {"name": "door without a host", "input": "door:subject:project:p1", "expected": {"error": "A door key is host|door"}},
    {"name": "door that names nothing", "input": "door:acme.starlings.work|home", "expected": {"error": "A door key is host|door"}},
    {"name": "Starlings task page", "input": "https://acme.starlings.work/work/task/T-1", "expected": {"key": "task:acme.starlings.work/T-1", "kind": "task", "id": "acme.starlings.work/T-1", "rawId": "acme.starlings.work/T-1", "url": "https://acme.starlings.work/work/task/T-1"}},
    {"name": "Starlings issue page", "input": "https://acme.starlings.work/work/issue/Acme/App/7", "expected": {"key": "issue:acme/app#7", "kind": "issue", "id": "acme/app#7", "rawId": "Acme/App#7", "url": null}},
    {"name": "Starlings project page", "input": "https://acme.starlings.work/work/project/p1", "expected": {"key": "door:acme.starlings.work|subject:project:p1", "kind": "door", "id": "acme.starlings.work|subject:project:p1", "rawId": "acme.starlings.work|subject:project:p1", "url": "https://acme.starlings.work/work/project/p1"}},
    {"name": "Starlings contact page", "input": "https://acme.starlings.work/work/contact/c1", "expected": {"key": "door:acme.starlings.work|contact:c1", "kind": "door", "id": "acme.starlings.work|contact:c1", "rawId": "acme.starlings.work|contact:c1", "url": "https://acme.starlings.work/work/contact/c1"}},
    {"name": "Starlings document page", "input": "https://acme.starlings.work/docs/document/d1", "expected": {"key": "door:acme.starlings.work|document:d1", "kind": "door", "id": "acme.starlings.work|document:d1", "rawId": "acme.starlings.work|document:d1", "url": "https://acme.starlings.work/docs/document/d1"}},
    {"name": "Starlings event page, encoded id", "input": "https://acme.starlings.work/calendar/event/cal%3Ae1", "expected": {"key": "door:acme.starlings.work|event:cal:e1", "kind": "door", "id": "acme.starlings.work|event:cal:e1", "rawId": "acme.starlings.work|event:cal:e1", "url": "https://acme.starlings.work/calendar/event/cal%3Ae1"}},
    {"name": "Starlings thread page", "input": "https://acme.starlings.work/team/thread/t1", "expected": {"key": "door:acme.starlings.work|thread:t1", "kind": "door", "id": "acme.starlings.work|thread:t1", "rawId": "acme.starlings.work|thread:t1", "url": "https://acme.starlings.work/team/thread/t1"}},
    {"name": "Starlings page with a query", "input": "https://acme.starlings.work/work/project/p1?pane=tasks#x", "expected": {"key": "door:acme.starlings.work|subject:project:p1", "kind": "door", "id": "acme.starlings.work|subject:project:p1", "rawId": "acme.starlings.work|subject:project:p1", "url": "https://acme.starlings.work/work/project/p1?pane=tasks"}},
    {"name": "Starlings page that names no record", "input": "https://acme.starlings.work/work/mine", "expected": {"key": "url:https://acme.starlings.work/work/mine", "kind": "url", "id": "https://acme.starlings.work/work/mine", "rawId": "https://acme.starlings.work/work/mine", "url": "https://acme.starlings.work/work/mine"}},
    {"name": "Starlings marketing host", "input": "https://starlings.work/work/task/T-1", "expected": {"key": "url:https://starlings.work/work/task/T-1", "kind": "url", "id": "https://starlings.work/work/task/T-1", "rawId": "https://starlings.work/work/task/T-1", "url": "https://starlings.work/work/task/T-1"}},
    {"name": "web URL", "input": "https://Example.COM/Path?B=2&a=1#frag", "expected": {"key": "url:https://example.com/Path?B=2&a=1", "kind": "url", "id": "https://example.com/Path?B=2&a=1", "rawId": "https://Example.COM/Path?B=2&a=1#frag", "url": "https://example.com/Path?B=2&a=1"}},
    {"name": "web URL, upper-case scheme and default port", "input": "HTTPS://example.com:443/", "expected": {"key": "url:https://example.com/", "kind": "url", "id": "https://example.com/", "rawId": "HTTPS://example.com:443/", "url": "https://example.com/"}},
    {"name": "web URL, http default port", "input": "http://example.com:80/a", "expected": {"key": "url:http://example.com/a", "kind": "url", "id": "http://example.com/a", "rawId": "http://example.com:80/a", "url": "http://example.com/a"}},
    {"name": "web URL, other port", "input": "https://example.com:8080/a", "expected": {"key": "url:https://example.com:8080/a", "kind": "url", "id": "https://example.com:8080/a", "rawId": "https://example.com:8080/a", "url": "https://example.com:8080/a"}},
    {"name": "web URL without a path", "input": "https://example.com", "expected": {"key": "url:https://example.com/", "kind": "url", "id": "https://example.com/", "rawId": "https://example.com", "url": "https://example.com/"}},
    {"name": "web URL with a query and no path", "input": "https://example.com?a=1", "expected": {"key": "url:https://example.com/?a=1", "kind": "url", "id": "https://example.com/?a=1", "rawId": "https://example.com?a=1", "url": "https://example.com/?a=1"}},
    {"name": "tracking parameters go", "input": "https://example.com/a?utm_source=x&id=1&fbclid=2&UTM_Medium=y&gclid=3&z=", "expected": {"key": "url:https://example.com/a?id=1&z=", "kind": "url", "id": "https://example.com/a?id=1&z=", "rawId": "https://example.com/a?utm_source=x&id=1&fbclid=2&UTM_Medium=y&gclid=3&z=", "url": "https://example.com/a?id=1&z="}},
    {"name": "only tracking parameters", "input": "https://example.com/a?utm_source=x", "expected": {"key": "url:https://example.com/a", "kind": "url", "id": "https://example.com/a", "rawId": "https://example.com/a?utm_source=x", "url": "https://example.com/a"}},
    {"name": "a parameter that looks like tracking stays", "input": "https://example.com/a?utm=1&gclidx=2", "expected": {"key": "url:https://example.com/a?utm=1&gclidx=2", "kind": "url", "id": "https://example.com/a?utm=1&gclidx=2", "rawId": "https://example.com/a?utm=1&gclidx=2", "url": "https://example.com/a?utm=1&gclidx=2"}},
    {"name": "white space around the URL", "input": "  https://example.com/a \n", "expected": {"key": "url:https://example.com/a", "kind": "url", "id": "https://example.com/a", "rawId": "https://example.com/a", "url": "https://example.com/a"}},
    {"name": "web URL on an IPv6 host", "input": "http://[2001:DB8::1]:8080/a", "expected": {"key": "url:http://[2001:db8::1]:8080/a", "kind": "url", "id": "http://[2001:db8::1]:8080/a", "rawId": "http://[2001:DB8::1]:8080/a", "url": "http://[2001:db8::1]:8080/a"}},
    {"name": "web URL on a non-ASCII host", "input": "https://B\u00dcCHER.example/a", "expected": {"key": "url:https://b\u00fccher.example/a", "kind": "url", "id": "https://b\u00fccher.example/a", "rawId": "https://B\u00dcCHER.example/a", "url": "https://b\u00fccher.example/a"}},
    {"name": "web URL with a user name", "input": "https://github.com@example.com/a", "expected": {"error": "The web URL is not valid"}},
    {"name": "web URL with a password", "input": "https://user:pass@example.com/a", "expected": {"error": "The web URL is not valid"}},
    {"name": "web URL with a space", "input": "https://example.com/a b", "expected": {"error": "The web URL is not valid"}},
    {"name": "web URL without a host", "input": "https:///a", "expected": {"error": "The web URL is not valid"}},
    {"name": "web URL without slashes", "input": "https:example.com", "expected": {"error": "The web URL is not valid"}},
    {"name": "web URL with a port that does not exist", "input": "https://example.com:99999/", "expected": {"error": "The web URL is not valid"}},
