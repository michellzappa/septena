    {"name": "another URL scheme", "input": "ftp://example.com/a", "expected": {"error": "The URL scheme is not supported"}},
    {"name": "attachment", "input": "file:attachment/att-1", "expected": {"key": "file:attachment/att-1", "kind": "file", "id": "attachment/att-1", "rawId": "attachment/att-1", "url": null}},
    {"name": "attachment id with a slash", "input": "file:attachment/a/b", "expected": {"error": "A file key is attachment/id or icloud/path"}},
    {"name": "iCloud path, decomposed", "input": "file:icloud/Re\u0301sume\u0301s/a.pdf", "expected": {"key": "file:icloud/R\u00e9sum\u00e9s/a.pdf", "kind": "file", "id": "icloud/R\u00e9sum\u00e9s/a.pdf", "rawId": "icloud/Re\u0301sume\u0301s/a.pdf", "url": null}},
    {"name": "iCloud path with outer slashes", "input": "file:icloud//Docs/Folder/", "expected": {"key": "file:icloud/Docs/Folder", "kind": "file", "id": "icloud/Docs/Folder", "rawId": "icloud//Docs/Folder/", "url": null}},
