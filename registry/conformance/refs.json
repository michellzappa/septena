    {"name": "unknown kind with control characters", "input": "zulip:a\u0007b", "expected": {"error": "The reference id has control characters"}},
    {"name": "kind that starts with a digit", "input": "1x:a", "expected": {"error": "The reference kind is not valid"}},
    {"name": "kind with a space", "input": "see this: a", "expected": {"error": "The reference kind is not valid"}},
    {"name": "kind that is too long", "input": "kkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkkk:a", "expected": {"error": "The reference kind is not valid"}},
    {"name": "no kind", "input": "hello", "expected": {"error": "Not a reference key, a web URL or a message link"}},
    {"name": "empty input", "input": "   ", "expected": {"error": "Not a reference key, a web URL or a message link"}},
    {"name": "key without an id", "input": "zulip:  ", "expected": {"error": "The reference id is empty"}},
