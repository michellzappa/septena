    {"name": "iCloud path with an empty part", "input": "file:icloud/a//b", "expected": {"error": "A file key is attachment/id or icloud/path"}},
    {"name": "file URL", "input": "file:///Users/x/a.pdf", "expected": {"error": "A file key is attachment/id or icloud/path"}},
