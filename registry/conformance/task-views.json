    {
      "name": "project heading is excluded from every task view",
      "task": { "id": "h1", "title": "Phase 1", "status": "open", "kind": "heading", "today": true, "project": "p1" },
      "expected": {
        "isUnfiled": false, "isInboxMember": false, "inTriageBand": false, "isOnToday": false, "inInbox": false,
