        "matchesView": { "today": false, "inbox": false, "upcoming": false, "anytime": false },
        "dueState": null, "deadlineRed": false, "upcomingDay": null, "arrivedOnOwn": false
      }
    },
    {
      "name": "faded task with an arrived When date is not on Today",
      "task": { "id": "v8", "title": "Faded", "status": "open", "today": false, "area": "work", "source": "app", "scheduled": "2026-11-15", "created": "2026-11-01", "fadedAt": "2026-11-20T10:00:00Z" },
      "expected": {
