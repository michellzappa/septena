    },
    {
      "name": "deadline only, due today: on Today, red, arrived on its own",
      "task": { "id": "v2", "title": "Send report", "status": "open", "today": false, "area": "work", "source": "app", "deadline": "2026-11-21", "created": "2026-11-15" },
      "expected": {
        "isUnfiled": false, "isInboxMember": false, "inTriageBand": false, "isOnToday": true, "inInbox": false,
