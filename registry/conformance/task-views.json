        "matchesView": { "today": false, "inbox": false, "upcoming": false, "anytime": true }
      }
    },
    {
      "name": "filed task scheduled in past arrives on Today with daysOnToday floored at created",
      "task": { "id": "t7", "title": "Backdated task", "status": "open", "today": false, "scheduled": "2026-11-10", "project": "p1", "source": "app", "created": "2026-11-19", "createdAt": "2026-11-19T08:00:00Z" },
      "expected": {
        "isUnfiled": false, "isInboxMember": false, "inTriageBand": false, "isOnToday": true, "inInbox": false,
