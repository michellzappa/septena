      "task": { "id": "v1", "title": "Pay invoice", "status": "open", "today": false, "area": "work", "source": "app", "deadline": "2026-11-19", "created": "2026-11-10" },
      "expected": {
        "isUnfiled": false, "isInboxMember": false, "inTriageBand": false, "isOnToday": true, "inInbox": false,
