        "dueState": "dueToday", "deadlineRed": true, "upcomingDay": null, "arrivedOnOwn": true
      }
    },
    {
      "name": "deadline only, in the future: Upcoming on the deadline day",
      "task": { "id": "v3", "title": "Book flights", "status": "open", "today": false, "area": "work", "source": "app", "deadline": "2026-11-28", "created": "2026-11-15" },
      "expected": {
        "isUnfiled": false, "isInboxMember": false, "inTriageBand": false, "isOnToday": false, "inInbox": false,
        "daysOnToday": 0,
        "matchesView": { "today": false, "inbox": false, "upcoming": true, "anytime": false },
        "dueState": null, "deadlineRed": false, "upcomingDay": "2026-11-28", "arrivedOnOwn": false
      }
    },
    {
      "name": "When date is today: on Today, arrived on its own",
      "task": { "id": "v4", "title": "Water plants", "status": "open", "today": false, "source": "app", "scheduled": "2026-11-21", "created": "2026-11-20", "project": "p1" },
      "expected": {
        "isUnfiled": false, "isInboxMember": false, "inTriageBand": false, "isOnToday": true, "inInbox": false,
        "daysOnToday": 0,
        "matchesView": { "today": true, "inbox": false, "upcoming": false, "anytime": false },
        "dueState": null, "deadlineRed": false, "upcomingDay": null, "arrivedOnOwn": true
      }
    },
    {
      "name": "When date is today on a task created today: not arrived on its own",
      "task": { "id": "v5", "title": "New today", "status": "open", "today": false, "area": "work", "source": "app", "scheduled": "2026-11-21", "created": "2026-11-21" },
      "expected": {
        "isUnfiled": false, "isInboxMember": false, "inTriageBand": false, "isOnToday": true, "inInbox": false,
        "daysOnToday": 0,
        "matchesView": { "today": true, "inbox": false, "upcoming": false, "anytime": false },
        "dueState": null, "deadlineRed": false, "upcomingDay": null, "arrivedOnOwn": false
      }
    },
