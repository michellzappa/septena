      }
    },
    {
      "name": "invalid When date reads as no date",
      "task": { "id": "v9", "title": "Bad date", "status": "open", "today": false, "area": "work", "source": "app", "scheduled": "2026-02-30", "created": "2026-11-01" },
      "expected": {
        "isUnfiled": false, "isInboxMember": false, "inTriageBand": false, "isOnToday": false, "inInbox": false,
