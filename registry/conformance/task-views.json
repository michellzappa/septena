        "isUnfiled": false, "isInboxMember": false, "inTriageBand": false, "isOnToday": false, "inInbox": false,
        "daysOnToday": 0,
        "matchesView": { "today": false, "inbox": false, "upcoming": false, "anytime": false },
        "dueState": null, "deadlineRed": false, "upcomingDay": null, "arrivedOnOwn": false
      }
    },
    {
      "name": "completed task is excluded from active views",
      "task": { "id": "t8", "title": "Shipped", "status": "done", "today": true, "completedAt": "2026-11-21T10:00:00Z" },
      "expected": {
        "isUnfiled": true, "isInboxMember": false, "inTriageBand": false, "isOnToday": false, "inInbox": false,
        "daysOnToday": 0,
        "matchesView": { "today": false, "inbox": false, "upcoming": false, "anytime": false },
        "dueState": null, "deadlineRed": false, "upcomingDay": null, "arrivedOnOwn": false
      }
    },
