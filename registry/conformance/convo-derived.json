{
  "version": 1,
  "description": "Golden conformance vectors for deriveConvo and awaitsReasoning across Swift, TypeScript, and Kotlin, and for the conversation predicates and Agent-list stage (conversationState) of the shared core (ADR 0025).",
  "cases": [
    {
      "name": "empty conversation with no assignee",
      "convo": { "thread": [] },
      "expected": { "stage": "open", "badge": null, "pendingReasoning": false }
    },
    {
      "name": "empty conversation assigned to claude is pending reasoning",
      "convo": { "assignee": "claude", "thread": [] },
      "expected": { "stage": "open", "badge": null, "pendingReasoning": true }
    },
    {
      "name": "provider turn with options awaits human",
      "convo": {
        "assignee": "claude",
        "thread": [
          { "seq": 1, "role": "provider", "step": "decide", "question": "Which option?", "options": ["A", "B"], "ts": "2026-11-20T10:00:00Z" }
        ]
      },
      "expected": { "stage": "awaitingHuman", "badge": "needsYou", "pendingReasoning": true }
    },
    {
      "name": "user answered provider question -> clarifying/working",
      "convo": {
        "assignee": "claude",
        "thread": [
          { "seq": 1, "role": "provider", "step": "decide", "question": "Which option?", "options": ["A", "B"], "ts": "2026-11-20T10:00:00Z" },
          { "seq": 2, "role": "user", "step": "decide", "chosen": "A", "inReplyTo": 1, "ts": "2026-11-20T10:05:00Z" }
        ]
      },
      "expected": { "stage": "clarifying", "badge": "working", "pendingReasoning": true }
    },
    {
      "name": "confirmed intent with user reply -> inProgress/working",
      "convo": {
        "assignee": "claude",
        "confirmedIntent": "Draft and test",
        "thread": [
          { "seq": 1, "role": "user", "step": "work", "note": "Go ahead", "ts": "2026-11-20T10:05:00Z" }
        ]
      },
      "expected": { "stage": "inProgress", "badge": "working", "pendingReasoning": true }
    },
    {
      "name": "low-confidence local provider turn triggers pendingReasoning",
      "convo": {
        "assignee": "local",
        "thread": [
          { "seq": 1, "role": "provider", "step": "ground", "provider": "onDevice", "confidence": 0.3, "note": "Uncertain", "ts": "2026-11-20T10:00:00Z" }
        ]
      },
      "expected": { "stage": "clarifying", "badge": "working", "pendingReasoning": true }
    },
    {
      "name": "stoppedAt halts pendingReasoning and clears badge",
      "convo": {
        "assignee": "claude",
        "stoppedAt": "2026-11-20T11:00:00Z",
        "thread": [
          { "seq": 1, "role": "user", "step": "work", "note": "Start", "ts": "2026-11-20T10:00:00Z" }
        ]
      },
      "expected": { "stage": "inProgress", "badge": null, "pendingReasoning": false }
    },
    {
      "name": "needs_verify awaits human review and stops agent queue",
      "convo": {
        "assignee": "claude",
        "endState": "needs_verify",
        "endStateNote": "Check PR #10",
        "thread": []
      },
      "expected": { "stage": "awaitingHuman", "badge": "needsYou", "pendingReasoning": false }
    },
    {
      "name": "agent_done is terminal done",
      "convo": {
        "assignee": "claude",
        "endState": "agent_done",
        "thread": []
      },
      "expected": { "stage": "terminal", "badge": "done", "pendingReasoning": false }
    },
    {
      "name": "wont_do is terminal wontDo",
      "convo": {
        "assignee": "claude",
        "endState": "wont_do",
        "thread": []
      },
      "expected": { "stage": "terminal", "badge": "wontDo", "pendingReasoning": false }
    }
  ],
  "conversationState": [
    {"name": "not agent work: no assignee, no claim, no review", "convo": {"thread": []}, "expected": {"isTerminal": false, "needsHumanReview": false, "hasOpenProviderQuestion": false, "awaitsHuman": false, "hasStarted": false, "isClaimed": false, "agentStage": null}},
    {"name": "assigned to claude with no turns is queued", "convo": {"assignee": "claude", "thread": []}, "expected": {"isTerminal": false, "needsHumanReview": false, "hasOpenProviderQuestion": false, "awaitsHuman": false, "hasStarted": false, "isClaimed": false, "agentStage": "queued"}},
    {"name": "open provider question is your turn", "convo": {"assignee": "claude", "thread": [{"seq": 1, "role": "provider", "step": "decide", "question": "Which?", "options": ["A", "B"], "ts": "2026-11-20T10:00:00Z"}]}, "expected": {"isTerminal": false, "needsHumanReview": false, "hasOpenProviderQuestion": true, "awaitsHuman": true, "hasStarted": true, "isClaimed": false, "agentStage": "yourTurn"}},
    {"name": "live claim is working", "convo": {"assignee": "claude", "claimUntil": "2026-11-20T12:30:00Z", "thread": [{"seq": 1, "role": "provider", "step": "decide", "question": "Which?", "options": ["A", "B"], "ts": "2026-11-20T10:00:00Z"}, {"seq": 2, "role": "user", "step": "work", "note": "Go", "ts": "2026-11-20T10:05:00Z"}]}, "expected": {"isTerminal": false, "needsHumanReview": false, "hasOpenProviderQuestion": false, "awaitsHuman": false, "hasStarted": true, "isClaimed": true, "agentStage": "working"}},
    {"name": "expired claim is queued", "convo": {"assignee": "claude", "claimUntil": "2026-11-20T11:00:00Z", "thread": [{"seq": 1, "role": "provider", "step": "decide", "question": "Which?", "options": ["A", "B"], "ts": "2026-11-20T10:00:00Z"}, {"seq": 2, "role": "user", "step": "work", "note": "Go", "ts": "2026-11-20T10:05:00Z"}]}, "expected": {"isTerminal": false, "needsHumanReview": false, "hasOpenProviderQuestion": false, "awaitsHuman": false, "hasStarted": true, "isClaimed": false, "agentStage": "queued"}},
    {"name": "live claim counts as agent work without the claude assignee", "convo": {"assignee": "me", "claimUntil": "2026-11-20T13:00:00Z", "thread": [{"seq": 2, "role": "user", "step": "work", "note": "Go", "ts": "2026-11-20T10:05:00Z"}]}, "expected": {"isTerminal": false, "needsHumanReview": false, "hasOpenProviderQuestion": false, "awaitsHuman": false, "hasStarted": true, "isClaimed": true, "agentStage": "working"}},
    {"name": "needs_verify is review even when assigned to me", "convo": {"assignee": "me", "endState": "needs_verify", "thread": []}, "expected": {"isTerminal": true, "needsHumanReview": true, "hasOpenProviderQuestion": false, "awaitsHuman": true, "hasStarted": true, "isClaimed": false, "agentStage": "review"}},
    {"name": "agent_done is done", "convo": {"assignee": "claude", "endState": "agent_done", "thread": []}, "expected": {"isTerminal": true, "needsHumanReview": false, "hasOpenProviderQuestion": false, "awaitsHuman": false, "hasStarted": true, "isClaimed": false, "agentStage": "done"}},
    {"name": "stopped agent work is your turn", "convo": {"assignee": "claude", "stoppedAt": "2026-11-20T11:00:00Z", "thread": [{"seq": 2, "role": "user", "step": "work", "note": "Go", "ts": "2026-11-20T10:05:00Z"}]}, "expected": {"isTerminal": false, "needsHumanReview": false, "hasOpenProviderQuestion": false, "awaitsHuman": false, "hasStarted": true, "isClaimed": false, "agentStage": "yourTurn"}},
    {"name": "open question on a local task is not agent work", "convo": {"assignee": "local", "thread": [{"seq": 1, "role": "provider", "step": "decide", "question": "Which?", "options": ["A", "B"], "ts": "2026-11-20T10:00:00Z"}]}, "expected": {"isTerminal": false, "needsHumanReview": false, "hasOpenProviderQuestion": true, "awaitsHuman": true, "hasStarted": true, "isClaimed": false, "agentStage": null}},
    {"name": "an artifact alone means the conversation has started", "convo": {"artifactExists": true, "thread": []}, "expected": {"isTerminal": false, "needsHumanReview": false, "hasOpenProviderQuestion": false, "awaitsHuman": false, "hasStarted": true, "isClaimed": false, "agentStage": null}}
  ]
}
