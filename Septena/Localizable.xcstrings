    "Rotating replaces your private feed link immediately. Existing calendar subscriptions will stop updating until you re-subscribe with the new URL." : {
      "comment" : "Generated from registry settings.copy.calendar_detail.rotateMessage.label. Edit registry/*.json or registry/l10n; Xcode edits are overwritten.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beim Erneuern wird dein privater Feed-Link sofort ersetzt. Bestehende Kalenderabos werden erst wieder aktualisiert, wenn du sie mit der neuen URL erneut abonnierst."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al cambiarlo, se sustituye inmediatamente tu enlace privado. Las suscripciones existentes dejarán de actualizarse hasta que vuelvas a suscribirte con la URL nueva."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le changement remplace immédiatement votre lien de flux privé. Les abonnements de calendrier existants cesseront de se mettre à jour jusqu’à ce que vous vous réabonniez avec la nouvelle URL."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La rigenerazione sostituisce subito il link privato del feed. Gli abbonamenti calendario esistenti smetteranno di aggiornarsi finché non ti abbonerai di nuovo con il nuovo URL."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bij vernieuwen wordt de privéfeedlink meteen vervangen. Bestaande agenda-abonnementen worden niet meer bijgewerkt totdat je je opnieuw abonneert met de nieuwe URL."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O novo link substitui o atual imediatamente. As assinaturas de calendário existentes deixarão de ser atualizadas até que você assine novamente usando o novo URL."
          }
        }
      }
    },
