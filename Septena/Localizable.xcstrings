    "Your agent slot is in use" : {
      "comment" : "Generated from registry plans.upsells.agents_full.title. Edit registry/*.json or registry/l10n; Xcode edits are overwritten.",
      "extractionState" : "manual"
    },
    "Your agent's questions, finished work and tasks in progress show up here, and so do tasks you are waiting on. Faded tasks do too." : {
      "comment" : "Generated from registry destinations.destinations.review.emptyState.detail. Edit registry/*.json or registry/l10n; Xcode edits are overwritten.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hier erscheinen Fragen, fertige Arbeit und laufende Aufgaben deines Agenten, und Aufgaben, auf die du wartest. Verblasste Aufgaben ebenfalls."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aquí aparecen las preguntas de tu agente, el trabajo terminado y las tareas en curso, y también las tareas que esperas de otros. Las tareas desvanecidas también."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les questions de ton agent, le travail terminé et les tâches en cours s’affichent ici, ainsi que les tâches que tu attends. Les tâches estompées aussi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Qui compaiono le domande del tuo agente, il lavoro finito e le attività in corso, e anche le attività che aspetti da altri. Anche le attività sbiadite."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hier verschijnen de vragen van je agent, afgerond werk en taken die lopen, en ook taken waarop je wacht. Vervaagde taken ook."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aqui aparecem as perguntas do seu agente, o trabalho concluído e as tarefas em andamento, e também as tarefas que você aguarda de outras pessoas. As tarefas esmaecidas também."
          }
        }
      }
    },
    "Your agent's questions, finished work and tasks in progress show up here, and tasks you are waiting on. Faded tasks do too." : {
