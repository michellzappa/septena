    "It also removes your tasks from this device and signs you out. You can’t undo this." : {
      "comment" : "Generated from registry settings.copy.delete_account.consequence.label. Edit registry/*.json or registry/l10n; Xcode edits are overwritten.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dadurch werden auch deine Aufgaben von diesem Gerät entfernt und du wirst abgemeldet. Das lässt sich nicht rückgängig machen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "También elimina tus tareas de este dispositivo y cierra tu sesión. No puedes deshacerlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vos tâches seront aussi supprimées de cet appareil et votre session sera fermée. Cette action est irréversible."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rimuove anche le tue attività da questo dispositivo e termina la sessione. Non puoi annullare questa operazione."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Het verwijdert ook je taken van dit apparaat en meldt je af. Dit kun je niet ongedaan maken."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Isso também remove suas tarefas deste dispositivo e tira você da conta. Não é possível desfazer."
          }
        }
      }
    },
