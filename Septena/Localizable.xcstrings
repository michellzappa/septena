    },
    "€60 a year or €7 a month" : {
      "comment" : "Generated from registry plans.levels.plus.detail. Edit registry/*.json or registry/l10n; Xcode edits are overwritten.",
      "extractionState" : "manual",
      "localizations" : {
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "€60 per jaar of €7 per maand"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "€60 por ano ou €7 por mês"
          }
        }
      }
    },
    "€120 a year" : {
      "comment" : "Generated from registry plans.cards.pro.priceLabel. Edit registry/*.json or registry/l10n; Xcode edits are overwritten.",
      "extractionState" : "manual",
      "localizations" : {
        "nl" : {
