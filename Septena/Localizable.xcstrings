    "Duplicate Tasks" : {
      "comment" : "Generated from registry actions.actions.task.duplicate.pluralTitle. Edit registry/*.json or registry/l10n; Xcode edits are overwritten.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aufgaben duplizieren"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Duplicar tareas"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dupliquer les tâches"
          }
        },
        "it" : {
