        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O pagamento é feito ao seu provedor de IA, não a nós."
          }
        }
      }
    },
    "You signed in with a different account. The tasks on this device belong to the account you used before. They are removed from this device, and this account’s tasks take their place." : {
      "comment" : "Generated from registry surfaces.accountSwitch.copy.body.label. Edit registry/*.json or registry/l10n; Xcode edits are overwritten.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du hast dich mit einem anderen Konto angemeldet. Die Aufgaben auf diesem Gerät gehören zu dem Konto, das du vorher benutzt hast. Sie werden von diesem Gerät entfernt, und die Aufgaben dieses Kontos treten an ihre Stelle."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Iniciaste sesión con otra cuenta. Las tareas de este dispositivo pertenecen a la cuenta que usabas antes. Se eliminan de este dispositivo y las tareas de esta cuenta ocupan su lugar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous vous êtes connecté avec un autre compte. Les tâches de cet appareil appartiennent au compte que vous utilisiez avant. Elles sont retirées de cet appareil et les tâches de ce compte prennent leur place."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hai effettuato l’accesso con un altro account. Le attività su questo dispositivo appartengono all’account che usavi prima. Vengono rimosse da questo dispositivo e le attività di questo account prendono il loro posto."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je bent ingelogd met een ander account. De taken op dit apparaat horen bij het account dat je eerder gebruikte. Ze worden van dit apparaat verwijderd en de taken van dit account komen ervoor in de plaats."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você entrou com outra conta. As tarefas deste dispositivo pertencem à conta que você usava antes. Elas são removidas deste dispositivo, e as tarefas desta conta ficam no lugar."
          }
        }
      }
    },
    "You’re all set" : {
      "comment" : "Generated from registry surfaces.firstRun.steps.done.title. Edit registry/*.json or registry/l10n; Xcode edits are overwritten.",
