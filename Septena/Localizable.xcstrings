    "Offers a few options for you to pick. A harder call may use the cloud." : {
      "comment" : "Generated from registry settings.copy.ai_explainer.decideDetail.label. Edit registry/*.json or registry/l10n; Xcode edits are overwritten.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Macht dir einige Vorschläge zur Auswahl. Bei schwierigeren Fragen kann die Cloud zum Einsatz kommen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Te ofrece algunas opciones para elegir. Una decisión más difícil puede usar la nube."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Propose quelques options. Une décision plus complexe peut nécessiter le cloud."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ti propone alcune opzioni tra cui scegliere. Per decisioni più difficili può usare il cloud."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geeft je een paar opties waaruit je kunt kiezen. Voor een lastigere keuze kan de cloud worden gebruikt."
