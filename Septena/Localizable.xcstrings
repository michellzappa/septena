        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ningún plan limita el número de tareas, listas, proyectos o áreas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aucun forfait ne limite le nombre de tâches, listes, projets ou domaines."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
