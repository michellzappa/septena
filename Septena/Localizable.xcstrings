    "Some tasks need thinking before you can act. Tap Discuss and talk them through, right on the task." : {
      "comment" : "Generated from registry settings.copy.ai_explainer.intro.label. Edit registry/*.json or registry/l10n; Xcode edits are overwritten.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Manche Aufgaben wollen erst durchdacht werden. Tippe auf Besprechen, um direkt bei der Aufgabe darüber zu sprechen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Algunas tareas requieren reflexión. Pulsa Conversar para hablarlo directamente en la tarea."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Certaines tâches demandent réflexion avant d’agir. Touchez Discuter pour y réfléchir directement dans la tâche."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alcune attività richiedono un po’ di riflessione. Tocca «Parlane» per ragionarci direttamente nell’attività."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sommige taken vragen om nadenken voordat je iets kunt doen. Tik op Overleggen en bespreek ze direct bij de taak."
