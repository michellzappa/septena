    "Septena could not reach the server. Try again in a moment." : {
      "comment" : "Generated from registry plans.paywall.syncThisDeviceFailed. Edit registry/*.json or registry/l10n; Xcode edits are overwritten.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Septena konnte den Server nicht erreichen. Versuche es gleich noch einmal."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Septena no ha podido conectarse con el servidor. Inténtalo de nuevo dentro de un momento."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Septena n’a pas pu joindre le serveur. Réessayez dans un instant."
