    "A change couldn’t be saved" : {
      "comment" : "Generated from registry surfaces.prompts.items.changeNotSaved.title. Edit registry/*.json or registry/l10n; Xcode edits are overwritten.",
      "extractionState" : "manual"
    },
    "A free account connects one agent. Plus connects three. Pro has no limit." : {
      "comment" : "Generated from registry plans.upsells.agents_full.detail. Edit registry/*.json or registry/l10n; Xcode edits are overwritten.",
      "extractionState" : "manual"
    },
    "A free account shows 30 days of history. Plus shows a full year." : {
      "comment" : "Generated from registry plans.upsells.history_edge.detail. Edit registry/*.json or registry/l10n; Xcode edits are overwritten.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein kostenloses Konto zeigt 30 Tage Verlauf. Plus zeigt ein ganzes Jahr."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una cuenta gratuita muestra 30 días de historial. Plus muestra un año completo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un compte gratuit affiche 30 jours d’historique. Plus affiche une année entière."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un account gratuito mostra 30 giorni di cronologia. Plus ne mostra un anno intero."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Een gratis account toont 30 dagen geschiedenis. Plus toont een heel jaar."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A conta gratuita mostra 30 dias de histórico. O Plus mostra um ano completo."
          }
        }
      }
    },
    "A free account syncs one device. Plus syncs all of them. You can also move your free account to this device." : {
      "comment" : "Generated from registry plans.upsells.second_device.detail. Edit registry/*.json or registry/l10n; Xcode edits are overwritten.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein kostenloses Konto synchronisiert ein Gerät. Plus synchronisiert alle Geräte. Du kannst dein kostenloses Konto auch auf dieses Gerät übertragen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una cuenta gratuita sincroniza un dispositivo. Plus los sincroniza todos. También puedes pasar tu cuenta gratuita a este dispositivo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un compte gratuit synchronise un appareil. Plus les synchronise tous. Vous pouvez aussi transférer votre compte gratuit sur cet appareil."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un account gratuito sincronizza un dispositivo. Plus li sincronizza tutti. Puoi anche trasferire il tuo account gratuito su questo dispositivo."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Een gratis account synchroniseert één apparaat. Plus synchroniseert ze allemaal. Je kunt je gratis account ook naar dit apparaat verplaatsen."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A conta gratuita sincroniza um dispositivo. O Plus sincroniza todos eles. Você também pode transferir sua conta gratuita para este dispositivo."
          }
        }
      }
    },
