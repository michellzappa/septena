    "Does what it can: a draft, a comparison. Uses the web or your Claude only when needed." : {
      "comment" : "Generated from registry settings.copy.ai_explainer.workDetail.label. Edit registry/*.json or registry/l10n; Xcode edits are overwritten.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erledigt, was möglich ist: einen Entwurf oder Vergleich erstellen. Nutzt nur bei Bedarf das Web oder dein Claude."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hace lo que puede: un borrador o una comparación. Solo usa la web o tu Claude cuando hace falta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fait ce qu’il peut : un brouillon, une comparaison. N’utilise le Web ou votre Claude qu’en cas de besoin."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fa ciò che può: prepara una bozza o un confronto. Usa il web o il tuo Claude solo quando serve."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Doet wat het kan: een concept, een vergelijking. Gebruikt het web of jouw Claude alleen wanneer dat nodig is."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Faz o que pode, como criar um rascunho ou comparar opções. Só acessa a internet ou seu Claude quando necessário."
          }
        }
      }
    },
