    },
    "Septena runs the sync server and the connector. When you connect Claude or another agent, its bill stays with that provider." : {
      "comment" : "Generated from registry plans.promises.own_ai.detail. Edit registry/*.json or registry/l10n; Xcode edits are overwritten.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Septena betreibt den Synchronisierungsserver und den Connector. Wenn du Claude oder einen anderen Agenten verbindest, zahlst du weiterhin dessen Anbieter."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Septena mantiene el servidor de sincronización y el conector. Cuando conectas Claude u otro agente, sigues pagando a ese proveedor."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Septena gère le serveur de synchronisation et le connecteur. Lorsque vous connectez Claude ou un autre agent, la facturation reste à la charge de ce fournisseur."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Septena gestisce il server di sincronizzazione e il connettore. Quando connetti Claude o un altro agente, i costi restano a carico del relativo fornitore."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Septena beheert de synchronisatieserver en de connector. Als je Claude of een andere agent verbindt, betaal je de kosten aan die aanbieder."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O app Septena mantém o servidor de sincronização e o conector. Quando você conecta o Claude ou outro agente, a cobrança fica com o respectivo provedor."
          }
        }
      }
    },
    "Septena shows this key only once. Paste it into your script or agent. To stop the agent, disconnect it in this list." : {
      "comment" : "Generated from registry surfaces.prompts.items.agentKeyCreated.message. Edit registry/*.json or registry/l10n; Xcode edits are overwritten.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Septena zeigt diesen Schlüssel nur einmal. Füge ihn in dein Skript oder deinen Agenten ein. Um den Agenten zu stoppen, trenne ihn in dieser Liste."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
