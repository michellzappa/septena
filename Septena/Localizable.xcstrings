    "Every plan has the full task app" : {
      "comment" : "Generated from registry plans.fullApp.title. Edit registry/*.json or registry/l10n; Xcode edits are overwritten.",
      "extractionState" : "manual",
      "localizations" : {
        "nl" : {
          "stringUnit" : {
