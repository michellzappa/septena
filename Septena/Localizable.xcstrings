    "Tasks without activity for 14 days appear here until you keep them or let them go." : {
      "comment" : "Generated from registry destinations.destinations.faded.emptyState.detail. Edit registry/*.json or registry/l10n; Xcode edits are overwritten.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aufgaben ohne Aktivität seit 14 Tagen erscheinen hier, bis du sie behältst oder loslässt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aquí aparecen las tareas sin actividad durante 14 días hasta que las conserves o las descartes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les tâches sans activité depuis 14 jours apparaissent ici jusqu’à ce que vous les gardiez ou les laissiez partir."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Qui appaiono le attività senza attività da 14 giorni finché non le tieni o le lasci andare."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Taken die 14 dagen geen activiteit hadden, verschijnen hier tot je ze houdt of loslaat."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As tarefas sem atividade há 14 dias aparecem aqui até você mantê-las ou descartá-las."
          }
        }
      }
    },
    "Tasks without activity for 14 days fade out and move to Review. This applies on all your devices." : {
      "comment" : "Generated from registry settings.pages.general.sections.lists.items.3.detail. Edit registry/*.json or registry/l10n; Xcode edits are overwritten.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aufgaben ohne Aktivität verblassen nach 14 Tagen und wandern zu „Prüfen“. Das gilt auf allen deinen Geräten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las tareas sin actividad durante 14 días se atenúan y pasan a Revisar. Se aplica en todos tus dispositivos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les tâches sans activité depuis 14 jours s’estompent et passent dans Vérifier. Cela vaut pour tous vos appareils."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dopo 14 giorni senza attività, le attività perdono risalto e passano in Revisione. Vale su tutti i tuoi dispositivi."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Taken zonder activiteit gedurende 14 dagen vervagen en gaan naar Beoordelen. Dit geldt op al je apparaten."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Depois de 14 dias sem atividade, as tarefas perdem destaque e vão para Revisar. Vale em todos os seus dispositivos."
          }
        }
      }
    },
    "Tasks you assign to Claude show up in Review, grouped by where the work stands." : {
      "comment" : "Generated from registry destinations.destinations.agent.emptyState.detail. Edit registry/*.json or registry/l10n; Xcode edits are overwritten.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aufgaben, die du Claude zuweist, erscheinen in Prüfen, gruppiert nach Arbeitsstand."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las tareas que asignas a Claude aparecen en Revisar, agrupadas según su estado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les tâches confiées à Claude apparaissent dans Vérifier, regroupées selon leur avancement."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le attività assegnate a Claude appaiono in Revisione, raggruppate in base allo stato del lavoro."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Taken die je aan Claude toewijst, verschijnen in Beoordelen, gegroepeerd op de voortgang."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As tarefas que você atribuir ao Claude aparecem em Revisar, agrupadas pelo andamento do trabalho."
          }
        }
      }
    },
    "Tasks you complete or let go end up here." : {
      "comment" : "Generated from registry destinations.destinations.logbook.emptyState.detail. Edit registry/*.json or registry/l10n; Xcode edits are overwritten.",
