    "Connect Claude and two more. Each one asks before it acts." : {
      "comment" : "Generated from registry plans.benefits.plus.agents.detail. Edit registry/*.json or registry/l10n; Xcode edits are overwritten.",
      "extractionState" : "manual"
    },
    "Connect Claude or another agent to your list. It asks before it acts, and you can stop it at any time." : {
      "comment" : "Generated from registry plans.outcomes.agents.detail. Edit registry/*.json or registry/l10n; Xcode edits are overwritten.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verbinde Claude oder einen anderen Agenten mit deiner Liste. Er fragt, bevor er handelt, und du kannst ihn jederzeit stoppen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conecta Claude u otro agente a tu lista. Te pregunta antes de actuar y puedes detenerlo en cualquier momento."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Connectez Claude ou un autre agent à votre liste. Il demande votre accord avant d’agir, et vous pouvez l’arrêter à tout moment."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Connetti Claude o un altro agente al tuo elenco. Ti chiederà il permesso prima di agire e potrai fermarlo in qualsiasi momento."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verbind Claude of een andere agent met je lijst. De agent vraagt toestemming voordat die iets doet en je kunt de toegang op elk moment stoppen."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conecte o Claude ou outro agente à sua lista. Ele pede sua autorização antes de agir, e você pode interrompê-lo quando quiser."
          }
        }
      }
    },
    "Connect the agent you already use. You choose what it works on, and only you mark work done." : {
      "comment" : "Generated from registry surfaces.firstRun.steps.agentSetup.body. Edit registry/*.json or registry/l10n; Xcode edits are overwritten.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verbinde den Agenten, den du bereits nutzt. Du wählst aus, woran er arbeitet, und nur du hakst Aufgaben ab."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conecta el agente que ya usas. Tú eliges en qué trabaja y solo tú marcas el trabajo como hecho."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Connectez l’agent que vous utilisez déjà. Vous choisissez ce sur quoi il travaille, et vous seul marquez le travail comme terminé."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Connetti l’agente che usi già. Scegli tu su cosa lavora e solo tu segni il lavoro come completato."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verbind de agent die je al gebruikt. Jij kiest waar hij aan werkt, en alleen jij vinkt werk af."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conecte o agente que você já usa. Você escolhe em que ele trabalha, e só você marca o trabalho como concluído."
          }
        }
      }
    },
