    "Discuss never leaves this device. Septena has no on-device model here, so Discuss is off." : {
      "comment" : "Generated from registry settings.copy.aiMode.onDeviceOnlyNoModel.label. Edit registry/*.json or registry/l10n; Xcode edits are overwritten.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Besprechen bleibt immer auf diesem Gerät. Da Septena hier kein lokales Modell hat, ist die Funktion ausgeschaltet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conversar nunca sale de este dispositivo. Como Septena no tiene aquí un modelo local, Conversar está desactivado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La discussion reste toujours sur cet appareil. Septena n’y dispose d’aucun modèle local, donc la fonction Discuter est désactivée."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le conversazioni sulle attività restano su questo dispositivo. Qui Septena non dispone di un modello locale, quindi la funzione è disattivata."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Overleggen blijft op dit apparaat. Septena heeft hier geen model op het apparaat, dus Overleggen staat uit."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As conversas sobre tarefas ficam somente neste dispositivo. Como o app Septena não tem um modelo local aqui, esse recurso está desativado."
          }
        }
      }
    },
    "Dismiss" : {
