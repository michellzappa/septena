      }
    },
    "Septena has no on-device model here, so Discuss hands the task to your own Claude. Recommended." : {
      "comment" : "Generated from registry settings.copy.aiMode.autoNoModel.label. Edit registry/*.json or registry/l10n; Xcode edits are overwritten.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Septena hat hier kein Gerätemodell. Besprechen übergibt die Aufgabe daher an dein eigenes Claude. Empfohlen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Septena no tiene aquí un modelo en el dispositivo, así que Conversar pasa la tarea a tu Claude. Recomendado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Septena ne dispose d’aucun modèle local ici ; Discuter confie donc la tâche à votre propre Claude. Recommandé."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Qui Septena non dispone di un modello locale, quindi la funzione «Parlane» inoltra la richiesta al tuo Claude. Consigliato."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Septena heeft hier geen model op het apparaat, dus geeft Overleggen de taak door aan jouw eigen Claude. Aanbevolen."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Como o app Septena não tem um modelo local neste dispositivo, o recurso Conversar encaminha a tarefa para o seu Claude. Recomendado."
          }
        }
      }
    },
    "Septena Help" : {
