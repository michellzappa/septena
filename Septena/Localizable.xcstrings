            "value" : "Nutze für Überlegungen bevorzugt dein verbundenes Claude (dein Konto, deine Daten). %@ führt weiterhin niemals KI für deine Aufgaben aus."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Da preferencia a tu Claude conectado para razonar (tu cuenta, tus datos). %@ sigue sin ejecutar nunca IA en tus tareas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Privilégiez votre Claude connecté pour le raisonnement (votre compte, vos données). %@ n’exécute toujours jamais d’IA sur vos tâches."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Preferisci usare Claude connesso per ragionare (il tuo account, i tuoi dati). %@ non esegue comunque mai l’IA sulle tue attività."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gebruik bij voorkeur de Claude die je hebt verbonden voor redeneringen (jouw account, jouw gegevens). %@ voert nog steeds nooit AI uit op je taken."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prefere usar o Claude conectado para raciocinar (sua conta, seus dados). Mesmo assim, o %@ nunca executa IA nas suas tarefas."
          }
        }
      }
