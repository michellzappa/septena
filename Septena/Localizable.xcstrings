    },
    "Saturated Fat" : {
      "localizations" : {
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gordura saturada"
          }
        }
      }
    },
    "Say one of these to log without opening the app. Asking for a section that's turned off turns it back on automatically — your data is never lost. Every other action is Siri-callable too — open the Shortcuts app to give it a phrase." : {
      "localizations" : {
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diga um destes para registrar sem abrir o app. Pedir uma seção que está desativada a reativa automaticamente — seus dados nunca são perdidos. Toda outra ação também pode ser chamada pela Siri — abra o app Atalhos para dar um comando de voz a ela."
          }
        }
      }
    },
    "Schema prompts" : {
      "localizations" : {
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prompts de esquema"
          }
        }
      }
    },
    "Section off" : {
      "localizations" : {
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seção desativada"
          }
        }
      }
