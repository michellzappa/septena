      "extractionState" : "manual"
    },
    "Prices include VAT where it applies. Outside the euro area, the App Store charges its matching local price." : {
      "comment" : "Generated from registry plans.priceFootnote. Edit registry/*.json or registry/l10n; Xcode edits are overwritten.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
