    "Everything stays on this device. If a step needs a larger model, it pauses and asks you." : {
      "comment" : "Generated from registry settings.copy.aiMode.onDeviceOnly.label. Edit registry/*.json or registry/l10n; Xcode edits are overwritten.",
      "extractionState" : "manual",
      "localizations" : {
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tudo fica neste dispositivo. Se alguma etapa precisar de um modelo maior, o app pausa e pergunta se você quer continuar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tout reste sur cet appareil. Si une étape a besoin d’un modèle plus puissant, elle s’arrête et vous le demande."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alles bleibt auf diesem Gerät. Wenn ein Schritt ein größeres Modell benötigt, pausiert er und fragt dich."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todo permanece en este dispositivo. Si un paso necesita un modelo más grande, se pausa y te pregunta."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alles blijft op dit apparaat. Als een stap een groter model nodig heeft, pauzeert de app en vraagt het je."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tutto resta su questo dispositivo. Se un passaggio richiede un modello più potente, il processo si mette in pausa e ti chiede se vuoi continuare."
