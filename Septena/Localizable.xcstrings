    "Claude reads and changes your tasks through your Septena account. You decide which tasks it works on." : {
      "comment" : "Generated from registry surfaces.firstRun.steps.connectClaude.body. Edit registry/*.json or registry/l10n; Xcode edits are overwritten.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Claude liest und ändert deine Aufgaben über dein Septena-Konto. Du entscheidest, an welchen Aufgaben es arbeitet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Claude lee y modifica tus tareas a través de tu cuenta de Septena. Tú decides en qué tareas trabaja."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Claude lit et modifie vos tâches via votre compte Septena. Vous choisissez les tâches sur lesquelles il travaille."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Claude legge e modifica le tue attività tramite il tuo account Septena. Decidi tu su quali attività può lavorare."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Claude kan taken lezen en wijzigen via je Septena-account. Jij bepaalt aan welke taken het werkt."
          }
        },
