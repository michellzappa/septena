        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Archief- en hulplijsten staan onder je gebieden en projecten. Gebruik de pijlen om een lijst te rangschikken of omhoog of omlaag te verplaatsen. Wijzigingen worden gesynchroniseerd met al je apparaten."
          }
