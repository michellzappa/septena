    "Septena keeps deleted tasks here for 30 days, then deletes them for good." : {
      "comment" : "Generated from registry destinations.destinations.recentlyDeleted.emptyState.detail. Edit registry/*.json or registry/l10n; Xcode edits are overwritten.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Septena bewahrt gelöschte Aufgaben 30 Tage lang hier auf und löscht sie anschließend endgültig."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Septena guarda aquí las tareas eliminadas durante 30 días y después las borra definitivamente."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Septena conserve ici les tâches supprimées pendant 30 jours, puis les efface définitivement."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Septena conserva qui le attività eliminate per 30 giorni, poi le elimina definitivamente."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Septena bewaart verwijderde taken hier 30 dagen en verwijdert ze daarna definitief."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O app Septena mantém as tarefas apagadas aqui por 30 dias e depois as exclui definitivamente."
          }
        }
      }
    },
    "Septena Life" : {
      "comment" : "Generated from registry settings.pages.about.sections.companion.header. Edit registry/*.json or registry/l10n; Xcode edits are overwritten.",
      "extractionState" : "manual",
      "localizations" : {
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Septena Life"
          }
        }
      }
    },
    "Septena never runs AI on your data and never reads it. The intelligence is your own (Apple on-device, Private Cloud Compute, or your Claude). This only sets where requests may run." : {
      "comment" : "Generated from registry settings.pages.ai_preferences.sections.reach.footer. Edit registry/*.json or registry/l10n; Xcode edits are overwritten.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Septena führt niemals KI für deine Daten aus und liest sie auch nicht. Die Intelligenz stammt von dir (Apple auf dem Gerät, Private Cloud Compute oder dein Claude). Hier legst du nur fest, wo Anfragen ausgeführt werden dürfen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Septena nunca ejecuta IA en tus datos ni los lee. La inteligencia es tuya (Apple en el dispositivo, Private Cloud Compute o tu Claude). Esta opción solo determina dónde se pueden procesar las solicitudes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Septena n’exécute jamais d’IA sur vos données et ne les lit jamais. L’intelligence vous appartient (Apple sur l’appareil, Private Cloud Compute ou votre Claude). Ce réglage détermine uniquement où les requêtes peuvent être exécutées."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Septena non esegue mai l’IA sui tuoi dati e non li legge. L’intelligenza è la tua (Apple sul dispositivo, Private Cloud Compute o il tuo Claude). Questa impostazione determina solo dove possono essere elaborate le richieste."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Septena voert nooit AI uit op je gegevens en leest die ook niet. De intelligentie is van jou (AI op je apparaat van Apple, Private Cloud Compute of jouw Claude). Dit bepaalt alleen waar aanvragen mogen worden uitgevoerd."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O app Septena nunca usa IA nos seus dados nem os lê. A inteligência é sua (Apple no dispositivo, Private Cloud Compute ou seu Claude). Esta opção só define onde as solicitações podem ser processadas."
          }
        }
      }
    },
    "Septena Plus" : {
      "comment" : "Generated from registry settings.pages.account.sections.plan.items.0.label. Edit registry/*.json or registry/l10n; Xcode edits are overwritten.",
