          "stringUnit" : {
            "state" : "translated",
            "value" : "O Septena não conseguiu se conectar ao servidor. Tente novamente em instantes."
          }
        }
      }
    },
    "Septena has no on-device model here, so Discuss hands the task to your own Claude. Recommended." : {
      "comment" : "Generated from registry settings.copy.aiMode.autoNoModel.label. Edit registry/*.json or registry/l10n; Xcode edits are overwritten.",
      "extractionState" : "manual",
      "localizations" : {
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Septena heeft hier geen model op het apparaat, dus geeft Overleggen de taak door aan jouw eigen Claude. Aanbevolen."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Septena não tem um modelo local aqui, então o modo Discutir encaminha a tarefa para o seu Claude. Recomendado."
          }
        }
      }
    },
    "Septena keeps deleted tasks here for 30 days, then deletes them for good." : {
      "comment" : "Generated from registry destinations.destinations.recentlyDeleted.emptyState.detail. Edit registry/*.json or registry/l10n; Xcode edits are overwritten.",
      "extractionState" : "manual",
      "localizations" : {
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Septena bewaart verwijderde taken hier 30 dagen en verwijdert ze daarna definitief."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Septena guarda as tarefas apagadas aqui por 30 dias e depois as apaga de vez."
          }
        }
      }
    },
    "Septena Life" : {
      "comment" : "Generated from registry settings.pages.about.sections.companion.header. Edit registry/*.json or registry/l10n; Xcode edits are overwritten.",
      "extractionState" : "manual",
      "localizations" : {
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Septena Life"
          }
        }
      }
    },
    "Septena never runs AI on your data and never reads it. The intelligence is your own (Apple on-device, Private Cloud Compute, or your Claude). This only sets where requests may run." : {
      "comment" : "Generated from registry settings.pages.ai_preferences.sections.reach.footer. Edit registry/*.json or registry/l10n; Xcode edits are overwritten.",
      "extractionState" : "manual",
      "localizations" : {
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Septena voert nooit AI uit op je gegevens en leest die ook niet. De intelligentie is van jou (AI op je apparaat van Apple, Private Cloud Compute of jouw Claude). Dit bepaalt alleen waar aanvragen mogen worden uitgevoerd."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Septena nunca roda IA nos seus dados e nunca os lê. A inteligência é sua (Apple no dispositivo, Private Cloud Compute ou seu Claude). Isto só define onde as solicitações podem rodar."
          }
        }
      }
    },
