    "Your account becomes a free account. Every device keeps its tasks, and the server keeps your synced copy for 12 months." : {
      "comment" : "Generated from registry plans.promises.cancel.detail. Edit registry/*.json or registry/l10n; Xcode edits are overwritten.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein Konto wird kostenlos. Jedes Gerät behält seine Aufgaben, und der Server bewahrt deine synchronisierte Kopie 12 Monate lang auf."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu cuenta pasa a ser gratuita. Cada dispositivo conserva sus tareas y el servidor guarda tu copia sincronizada durante 12 meses."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre compte passe à l’offre gratuite. Chaque appareil conserve ses tâches et le serveur garde votre copie synchronisée pendant 12 mois."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il tuo account diventa gratuito. Ogni dispositivo conserva le proprie attività e il server mantiene la copia sincronizzata per 12 mesi."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je account wordt een gratis account. Elk apparaat behoudt zijn taken en de server bewaart je gesynchroniseerde kopie 12 maanden."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sua conta passa a ser gratuita. Cada dispositivo mantém suas tarefas, e o servidor guarda a cópia sincronizada por 12 meses."
          }
        }
      }
    },
    "Your account is now a free account. One device keeps syncing. Your tasks on every device stay where they are." : {
      "comment" : "Generated from registry plans.upsells.trial_end.detail. Edit registry/*.json or registry/l10n; Xcode edits are overwritten.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein Konto ist jetzt kostenlos. Ein Gerät wird weiter synchronisiert. Deine Aufgaben bleiben auf allen Geräten an ihrem Platz."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu cuenta ya es gratuita. Un dispositivo seguirá sincronizándose. Tus tareas se quedan donde están en todos los dispositivos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre compte est maintenant gratuit. Un appareil continue de se synchroniser. Vos tâches restent à leur place sur tous vos appareils."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il tuo account è ora gratuito. Un dispositivo continua a sincronizzarsi. Le tue attività restano su ogni dispositivo."
