    "Your tasks, areas and projects" : {
      "comment" : "Generated from registry settings.copy.delete_account.tasks.label. Edit registry/*.json or registry/l10n; Xcode edits are overwritten.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Aufgaben, Bereiche und Projekte"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tus tareas, áreas y proyectos"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vos tâches, domaines et projets"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le tue attività, aree e progetti"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je taken, gebieden en projecten"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suas tarefas, áreas e projetos"
          }
        }
      }
    },
    "Your tasks, areas, projects, and conversations stay on this device until you sign in. When signed in, they sync through Septena’s private server at api.septena.app, encrypted at rest (not end-to-end, so connected agents can read them when you choose). AI on your device stays on your device. Connect an agent under Agents." : {
      "comment" : "Generated from registry settings.pages.privacy.sections.data_locality.items.0.detail. Edit registry/*.json or registry/l10n; Xcode edits are overwritten.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Aufgaben, Bereiche, Projekte und Unterhaltungen bleiben auf diesem Gerät, bis du dich anmeldest. Nach der Anmeldung werden sie über Septenas privaten Server unter api.septena.app synchronisiert, verschlüsselt gespeichert (nicht Ende-zu-Ende, damit verbundene Agenten sie lesen können, wenn du es willst). KI auf deinem Gerät bleibt auf deinem Gerät. Verbinde einen Agenten unter Agenten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tus tareas, áreas, proyectos y conversaciones se quedan en este dispositivo hasta que inicies sesión. Con la sesión iniciada, se sincronizan a través del servidor privado de Septena en api.septena.app, cifradas en reposo (no de extremo a extremo, para que los agentes conectados puedan leerlas cuando tú quieras). La IA de tu dispositivo se queda en tu dispositivo. Conecta un agente en Agentes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tes tâches, domaines, projets et conversations restent sur cet appareil jusqu’à ce que tu te connectes. Une fois connecté, ils se synchronisent via le serveur privé de Septena sur api.septena.app, chiffrés au repos (pas de bout en bout, pour que les agents connectés puissent les lire quand tu le choisis). L’IA de ton appareil reste sur ton appareil. Connecte un agent dans Agents."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le tue attività, aree, progetti e conversazioni restano su questo dispositivo finché non accedi. Dopo l’accesso si sincronizzano tramite il server privato di Septena su api.septena.app, cifrati a riposo (non end-to-end, così gli agenti collegati possono leggerli quando lo scegli tu). L’IA sul tuo dispositivo resta sul tuo dispositivo. Collega un agente in Agenti."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je taken, gebieden, projecten en gesprekken blijven op dit apparaat tot je inlogt. Na het inloggen synchroniseren ze via de privéserver van Septena op api.septena.app, versleuteld opgeslagen (niet end-to-end, zodat gekoppelde agents ze kunnen lezen als jij dat kiest). AI op je apparaat blijft op je apparaat. Koppel een agent onder Agents."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suas tarefas, áreas, projetos e conversas ficam neste dispositivo até você entrar. Depois de entrar, eles sincronizam pelo servidor privado do Septena em api.septena.app, criptografados em repouso (não de ponta a ponta, para que agentes conectados possam lê-los quando você escolher). A IA do seu dispositivo fica no seu dispositivo. Conecte um agente em Agentes."
          }
        }
      }
    },
    "Your tasks, areas, projects, and conversations stay on this device until you sign in. When signed in, they sync through Septena’s private server at api.septena.app, encrypted at rest (not end-to-end, so connected agents can read them when you choose). AI on your device stays on your device. Connect an agent under AI & Agents." : {
      "comment" : "Generated from registry settings.pages.privacy.sections.data_locality.items.0.detail. Edit registry/*.json or registry/l10n; Xcode edits are overwritten.",
      "extractionState" : "manual"
    },
    "Your tasks, areas, projects, and conversations stay on this device until you sign in. When signed in, they sync through Septena’s private server at api.septena.app, encrypted at rest (not end-to-end, so connected agents can read them when you choose). AI on your device stays on your device. Connect Claude under AI & Agents." : {
      "comment" : "Generated from registry settings.pages.privacy.sections.data_locality.items.0.detail. Edit registry/*.json or registry/l10n; Xcode edits are overwritten.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Aufgaben, Bereiche, Projekte und Unterhaltungen bleiben auf diesem Gerät, bis du dich anmeldest. Danach werden sie über Septenas privaten Server unter api.septena.app synchronisiert und im Ruhezustand verschlüsselt (nicht Ende-zu-Ende, damit verbundene Agenten sie lesen können, wenn du es erlaubst). Die KI auf deinem Gerät bleibt dort. Verbinde Claude unter KI und Agenten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tus tareas, áreas, proyectos y conversaciones permanecen en este dispositivo hasta que inicies sesión. Después se sincronizan mediante el servidor privado de Septena en api.septena.app y se cifran en reposo (no con cifrado de extremo a extremo, por lo que los agentes conectados pueden leerlas cuando tú lo permitas). La IA de tu dispositivo permanece en él. Conecta Claude en IA y agentes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vos tâches, domaines, projets et conversations restent sur cet appareil jusqu’à votre connexion. Une fois connecté, leur synchronisation passe par le serveur privé de Septena à api.septena.app, où elles sont chiffrées au repos (le chiffrement n’est pas de bout en bout : les agents connectés peuvent donc les lire lorsque vous le choisissez). L’IA de votre appareil reste sur celui-ci. Connectez Claude dans IA et agents."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le tue attività, aree, progetti e conversazioni restano su questo dispositivo finché non accedi. Dopo l’accesso, si sincronizzano tramite il server privato di Septena su api.septena.app, con crittografia a riposo (non end-to-end, quindi gli agenti connessi possono leggerle quando lo scegli). L’IA sul tuo dispositivo resta sul tuo dispositivo. Connetti Claude in IA e agenti."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je taken, gebieden, projecten en gesprekken blijven op dit apparaat totdat je je aanmeldt. Na aanmelding worden ze gesynchroniseerd via de privéserver van Septena op api.septena.app, versleuteld opgeslagen (niet end-to-end, zodat verbonden agents ze kunnen lezen wanneer jij daarvoor kiest). AI op je apparaat blijft op je apparaat. Verbind Claude onder AI en agents."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suas tarefas, áreas, projetos e conversas ficam neste dispositivo até você entrar. Depois de entrar, elas sincronizam pelo servidor privado do Septena em api.septena.app, criptografadas em repouso (não de ponta a ponta, então agentes conectados podem lê-las quando você escolher). A IA no seu dispositivo fica no seu dispositivo. Conecte o Claude em IA e agentes."
          }
        }
      }
    },
    "Your turn" : {
      "comment" : "Generated from registry destinations.destinations.agent.groups.yourTurn.title. Edit registry/*.json or registry/l10n; Xcode edits are overwritten.",
      "extractionState" : "manual",
