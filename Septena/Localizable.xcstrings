    "Open a task or choose Keep to bring it back, or review the list and let the rest go." : {
      "comment" : "Generated from registry surfaces.notices.items.fadedPile.detail. Edit registry/*.json or registry/l10n; Xcode edits are overwritten.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Öffne eine Aufgabe oder wähle Behalten, um sie zurückzuholen. Du kannst auch die Liste prüfen und die übrigen freigeben."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abre una tarea o elige Conservar para recuperarla, o revisa la lista y deja ir las demás."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ouvrez une tâche ou choisissez Conserver pour la réactiver, ou examinez la liste et abandonnez les autres."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apri un’attività o scegli Mantieni per recuperarla; altrimenti rivedi l’elenco e scarta le altre."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Open een taak of kies Behouden om die terug te zetten, of bekijk de lijst en laat de rest verwijderen."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abra uma tarefa ou escolha Manter para trazê-la de volta. Revise a lista e descarte as demais."
          }
        }
      }
    },
