    "Anyone can join a shared project for free. Plus lets you create one and invite people." : {
      "comment" : "Generated from registry plans.upsells.share_create.detail. Edit registry/*.json or registry/l10n; Xcode edits are overwritten.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jeder kann kostenlos einem geteilten Projekt beitreten. Mit Plus kannst du ein Projekt erstellen und andere einladen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cualquiera puede unirse gratis a un proyecto compartido. Con Plus puedes crear uno e invitar a otras personas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tout le monde peut rejoindre gratuitement un projet partagé. Plus vous permet d’en créer un et d’inviter des personnes."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chiunque può partecipare gratuitamente a un progetto condiviso. Con Plus puoi crearne uno e invitare altre persone."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Iedereen kan gratis deelnemen aan een gedeeld project. Met Plus kun je zelf een project maken en mensen uitnodigen."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Qualquer pessoa pode participar de um projeto compartilhado gratuitamente. Com o Plus, você pode criar um projeto e convidar pessoas."
          }
        }
      }
    },
    "Anything only you can do (pay, send) becomes one clear button." : {
      "comment" : "Generated from registry settings.copy.ai_explainer.handOffDetail.label. Edit registry/*.json or registry/l10n; Xcode edits are overwritten.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alles, was nur du tun kannst (bezahlen, senden), wird zu einer klaren Schaltfläche."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cualquier acción que solo tú puedas realizar (pagar, enviar) se convierte en un botón claro."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toute action réservée à vous (payer, envoyer) devient un bouton bien visible."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le azioni che puoi fare solo tu (pagare, inviare) diventano un unico pulsante chiaro."
