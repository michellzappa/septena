    "Sign in with Apple to keep your tasks on all your devices and connect your agents. Septena never sees your Apple password." : {
      "comment" : "Generated from registry surfaces.firstRun.steps.account.body. Edit registry/*.json or registry/l10n; Xcode edits are overwritten.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Melde dich mit Apple an, um deine Aufgaben auf allen Geräten zu synchronisieren und deine Agenten zu verbinden. Septena sieht dein Apple-Passwort nie."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inicia sesión con Apple para mantener tus tareas en todos tus dispositivos y conectar tus agentes. Septena nunca ve tu contraseña de Apple."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Connectez-vous avec Apple pour garder vos tâches sur tous vos appareils et connecter vos agents. Septena ne voit jamais votre mot de passe Apple."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Accedi con Apple per mantenere le tue attività su tutti i tuoi dispositivi e connettere i tuoi agenti. Septena non vede mai la tua password Apple."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Log in met Apple om je taken op al je apparaten gelijk te houden en je agents te verbinden. Septena ziet je Apple-wachtwoord nooit."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
