            "state" : "translated",
            "value" : "%lld selecionados"
          }
        }
      }
    },
    "%@ can read and change your tasks. You can pause it in AI & Agents." : {
      "comment" : "Generated from registry settings.copy.sign_in_approval.detailConnector.label. Edit registry/*.json or registry/l10n; Xcode edits are overwritten.",
      "extractionState" : "manual",
      "localizations" : {
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ kan je taken lezen en wijzigen. Je kunt de verbinding pauzeren bij AI en agents."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ pode ler e alterar suas tarefas. Você pode pausá-lo em IA e agentes."
          }
        }
      }
    },
    "%@ gets full access to your Septena account, including tasks, lists, conversations and settings. It stays signed in until you sign it out." : {
      "comment" : "Generated from registry settings.copy.sign_in_approval.detailDevice.label. Edit registry/*.json or registry/l10n; Xcode edits are overwritten.",
      "extractionState" : "manual",
      "localizations" : {
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ krijgt volledige toegang tot je Septena-account, inclusief taken, lijsten, gesprekken en instellingen. De aanmelding blijft actief totdat je je afmeldt."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ terá acesso completo à sua conta Septena, incluindo tarefas, listas, conversas e ajustes. A sessão continuará ativa até você encerrá-la."
          }
        }
      }
    },
    "%@ is signed in." : {
      "comment" : "Generated from registry settings.copy.sign_in_approval.doneDevice.label. Edit registry/*.json or registry/l10n; Xcode edits are overwritten.",
      "extractionState" : "manual",
      "localizations" : {
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ is aangemeld."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sessão iniciada em %@."
          }
        }
      }
    },
    "%@’s servers never run AI on your tasks. AI runs on your device, or in your own Claude when you connect it. Turn AI off and the app works the same, without conversations." : {
      "comment" : "Generated from registry settings.copy.ai_explainer.privateBody.label. Edit registry/*.json or registry/l10n; Xcode edits are overwritten.",
      "extractionState" : "manual",
      "localizations" : {
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De servers van %@ voeren nooit AI uit op je taken. AI draait op je apparaat of in je eigen Claude wanneer je die verbindt. Schakel AI uit en de app blijft hetzelfde werken, zonder gesprekken."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os servidores do %@ nunca executam IA nas suas tarefas. A IA funciona no seu dispositivo ou no seu Claude quando você o conecta. Desative a IA e o app continuará funcionando da mesma forma, sem conversas."
          }
        }
      }
    },
    "%@ can no longer read or change your tasks. To use it again, connect it again." : {
      "comment" : "Generated from registry surfaces.prompts.items.disconnectAgent.message. Edit registry/*.json or registry/l10n; Xcode edits are overwritten.",
      "extractionState" : "manual",
      "localizations" : {
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ kan je taken niet meer lezen of wijzigen. Verbind %1$@ opnieuw om de agent weer te gebruiken."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ não pode mais ler nem alterar suas tarefas. Para usá-lo novamente, conecte-o outra vez."
          }
        }
      }
    },
