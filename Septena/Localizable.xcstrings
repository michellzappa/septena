    "You pay your AI provider, not us" : {
      "comment" : "Generated from registry plans.promises.own_ai.title. Edit registry/*.json or registry/l10n; Xcode edits are overwritten.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du bezahlst deinen KI-Anbieter, nicht uns"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pagas a tu proveedor de IA, no a nosotros"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous payez votre fournisseur d’IA, pas nous"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Paghi il tuo fornitore di IA, non noi"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jij betaalt je AI-aanbieder, niet ons"
