    },
    "Tasks, lists, projects and areas have no caps on any plan." : {
      "comment" : "Generated from registry plans.promises.core_free.detail. Edit registry/*.json or registry/l10n; Xcode edits are overwritten.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Für Aufgaben, Listen, Projekte und Bereiche gibt es in keinem Tarif Limits."
