    },
    "That device stops syncing within the hour. Its tasks stay on it until you sign in there again." : {
      "comment" : "Generated from registry settings.copy.access_devices.signOutMessage.label. Edit registry/*.json or registry/l10n; Xcode edits are overwritten.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieses Gerät stellt die Synchronisierung innerhalb einer Stunde ein. Die Aufgaben bleiben darauf, bis du dich dort wieder anmeldest."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ese dispositivo dejará de sincronizarse en una hora. Sus tareas permanecerán allí hasta que vuelvas a iniciar sesión."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cet appareil cessera de se synchroniser dans l’heure. Ses tâches y resteront jusqu’à votre prochaine connexion."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La sincronizzazione di quel dispositivo si interromperà entro un’ora. Le sue attività resteranno lì finché non accederai di nuovo."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dat apparaat synchroniseert binnen een uur niet meer. De taken blijven erop staan totdat je je daar opnieuw aanmeldt."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esse dispositivo deixará de sincronizar em até uma hora. As tarefas continuarão nele até você entrar novamente."
          }
        }
      }
    },
    "That sign-in method already belongs to another Septena account." : {
