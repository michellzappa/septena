    "One edit was rolled back and is not stored. Anything you typed just now may need retyping. Later changes still save normally." : {
      "comment" : "Generated from registry surfaces.prompts.items.changeNotSaved.message. Edit registry/*.json or registry/l10n; Xcode edits are overwritten.",
      "extractionState" : "manual"
    },
    "Only approve a code you started yourself. Septena never asks for a code by email, text or phone call." : {
      "comment" : "Generated from registry settings.copy.sign_in_approval.safetyFooter.label. Edit registry/*.json or registry/l10n; Xcode edits are overwritten.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bestätige nur einen Code, den du selbst angefordert hast. Septena fragt niemals per E-Mail, SMS oder Telefon nach einem Code."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aprueba solo los códigos que tú hayas solicitado. Septena nunca te pedirá un código por correo electrónico, mensaje de texto o llamada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "N’approuvez que les codes dont vous avez vous-même demandé la création. Septena ne demande jamais de code par e-mail, SMS ou téléphone."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Approva solo i codici che hai richiesto tu. Septena non ti chiederà mai un codice via email, SMS o telefono."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keur alleen een code goed die je zelf hebt gestart. Septena vraagt nooit om een code via e-mail, sms of telefoon."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aprove apenas um código que você mesmo solicitou. O Septena nunca pede códigos por e-mail, mensagem de texto ou ligação."
          }
        }
      }
    },
