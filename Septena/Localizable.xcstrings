        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les listes d’archives et utilitaires s’affichent sous vos domaines et projets. Utilisez les flèches pour les réordonner ou les déplacer vers le haut ou le bas. Les modifications se synchronisent sur tous vos appareils."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gli elenchi di archivio e utilità sono sotto le aree e i progetti. Usa le frecce per riordinarli o spostarli sopra o sotto. Le modifiche si sincronizzano su tutti i tuoi dispositivi."
          }
