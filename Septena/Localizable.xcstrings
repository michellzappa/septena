          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utilisez un appareil sur lequel Septena est déjà connecté. Il autorisera celui-ci avec un code et vos tâches se synchroniseront ici."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa un dispositivo su cui hai già effettuato l’accesso a Septena. Approverà questo dispositivo con un codice e le tue attività si sincronizzeranno qui."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gebruik een apparaat waarop Septena al is aangemeld. Daarmee keur je dit apparaat met een code goed, waarna je taken hier worden gesynchroniseerd."
          }
        },
        "pt-BR" : {
