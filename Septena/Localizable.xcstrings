          }
        }
      }
    },
    "%lld selected" : {
      "comment" : "Generated from registry surfaces.taskSelection.format. Edit registry/*.json or registry/l10n; Xcode edits are overwritten.",
      "extractionState" : "manual",
      "localizations" : {
        "nl" : {
          "stringUnit" : {
