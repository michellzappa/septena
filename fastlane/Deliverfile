# fastlane deliver — uploads Septena's App Store metadata + screenshots.
# Everything it uploads is generated: edit docs/APPSTORE.md (copy) and
# appstore/panels.config.mjs (visuals), then `cd appstore && npm run all`,
# verify with `npm run viz`, then `fastlane deliver` from the repo root.
#
# Auth: prefer an App Store Connect API key —
#   api_key_path("fastlane/asc_api_key.json")   # gitignored; {key_id, issuer_id, key (p8 contents)}
# or sign in interactively with FASTLANE_USER / app-specific password.
#
# macOS is a separate ASC app (com.septena.cloud.mac): when it goes live, run
# deliver with `--app_identifier com.septena.cloud.mac --platform osx
# --metadata_path appstore/metadata-mac --screenshots_path appstore/screenshots-mac`.

app_identifier "com.septena.cloud"
platform "ios"

metadata_path File.expand_path("../appstore/metadata", __dir__)
screenshots_path File.expand_path("../appstore/screenshots", __dir__)

skip_binary_upload true
overwrite_screenshots true
run_precheck_before_submit false

# Never auto-submit from this config — review in ASC after upload.
submit_for_review false
force true   # skip the interactive HTML preview; the viz is the review surface
