# fastlane deliver — uploads Septena's App Store metadata + screenshots.
# Everything it uploads is generated: edit docs/APPSTORE.md (copy) and
# appstore/panels.config.mjs (visuals), then `cd appstore && npm run all`,
# verify with `npm run viz`, then `fastlane deliver` from the repo root.
#
# Run it through appstore/upload.sh (docs/APPSTORE-SEPTASK.md "Uploading"):
# it picks the app, platform and paths and passes the API key from
# ~/.appstoreconnect/septena.json (outside the repo; appstore/asc-key.sh
# writes it). Never commit a key.
#
# macOS is a second platform on the same ASC record (com.septena.cloud, ADR
# 0007): when it goes live, run deliver with `--platform osx
# --metadata_path appstore/metadata-mac --screenshots_path appstore/screenshots-mac`.
#
# Septask is a second app with its own ASC record (iOS + macOS platforms). Build its package with
# `cd appstore && npm run all:septask`, then deliver each (bundle ids verified in
# project.yml — com.septena.tasks on both platforms):
#   fastlane deliver --app_identifier com.septena.tasks --platform ios \
#     --metadata_path appstore/metadata-septask \
#     --screenshots_path appstore/screenshots-septask
#   fastlane deliver --app_identifier com.septena.tasks --platform osx \
#     --metadata_path appstore/metadata-septask-mac \
#     --screenshots_path appstore/screenshots-septask-mac

app_identifier "com.septena.cloud"
platform "ios"

metadata_path File.expand_path("../appstore/metadata", __dir__)
screenshots_path File.expand_path("../appstore/screenshots", __dir__)

skip_binary_upload true
overwrite_screenshots true
run_precheck_before_submit false

# Never auto-submit from this config — review in ASC after upload.
submit_for_review false
force true   # skip the interactive HTML preview; the viz is the review surface
