  "strings" : {
    "NSCalendarsFullAccessUsageDescription" : {
      "comment" : "Explains why Septena requests full calendar access.",
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Septena shows today's calendar events above your task list." } },
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Septena zeigt die heutigen Kalenderereignisse über deiner Aufgabenliste an." } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Septena muestra los eventos del calendario de hoy encima de tu lista de tareas." } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Septena affiche les événements de calendrier du jour au-dessus de votre liste de tâches." } },
        "it" : { "stringUnit" : { "state" : "translated", "value" : "Septena mostra gli eventi del calendario di oggi sopra l’elenco delle tue attività." } },
        "nl" : { "stringUnit" : { "state" : "translated", "value" : "Septena toont de agenda-items van vandaag boven je takenlijst." } },
        "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "O app Septena mostra os eventos de hoje acima da sua lista de tarefas." } }
      }
    },
