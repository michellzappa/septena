    "NSCameraUsageDescription" : {
      "comment" : "Explains why Septena requests camera access to scan sign-in codes.",
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Septena uses the camera to scan sign-in codes from your other devices." } },
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Septena verwendet die Kamera, um Anmeldecodes von deinen anderen Geräten zu scannen." } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Septena usa la cámara para escanear códigos de inicio de sesión de tus otros dispositivos." } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Septena utilise l’appareil photo pour scanner les codes de connexion de vos autres appareils." } },
        "it" : { "stringUnit" : { "state" : "translated", "value" : "Septena usa la fotocamera per scansionare i codici di accesso dagli altri dispositivi." } },
        "nl" : { "stringUnit" : { "state" : "translated", "value" : "Septena gebruikt de camera om aanmeldcodes van je andere apparaten te scannen." } },
        "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "O app Septena usa a câmera para escanear os códigos de acesso dos seus outros dispositivos." } }
      }
    },
    "NSRemindersFullAccessUsageDescription" : {
      "comment" : "Explains why Septena requests full Reminders access.",
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Septena moves reminders from your Reminders lists into the Inbox and deletes them from Reminders." } },
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Septena verschiebt Erinnerungen aus deinen Erinnerungslisten in den Eingang und löscht sie aus Erinnerungen." } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Septena mueve los recordatorios de tus listas a la bandeja de entrada y los elimina de Recordatorios." } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Septena déplace les rappels de vos listes Rappels vers la boîte de réception et les supprime de Rappels." } },
        "it" : { "stringUnit" : { "state" : "translated", "value" : "Septena sposta i promemoria dai tuoi elenchi nella Posta in arrivo e li elimina da Promemoria." } },
        "nl" : { "stringUnit" : { "state" : "translated", "value" : "Septena verplaatst herinneringen uit je Herinneringen-lijsten naar je Postvak IN en verwijdert ze uit Herinneringen." } },
        "pt-BR" : { "stringUnit" : { "state" : "translated", "value" : "O app Septena move os lembretes das suas listas no app Lembretes para a Caixa de entrada e os apaga do app Lembretes." } }
      }
    },
