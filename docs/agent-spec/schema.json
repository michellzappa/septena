              "$ref": "#/$defs/day"
            },
            {
              "type": "null"
            }
          ]
        },
        "completedAt": {
          "anyOf": [
            {
              "allOf": [
                {
                  "$ref": "#/$defs/stamp"
                },
                {
                  "maxLength": 40
                }
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "notes": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 100000
            },
            {
              "type": "null"
            }
          ]
        },
        "position": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        },
        "todayPosition": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        },
        "recurrenceUnit": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 16
            },
            {
              "type": "null"
            }
          ]
        },
        "recurrenceInterval": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        },
        "recurrenceAfterCompletion": {
          "type": "boolean",
          "default": false
        },
        "recurrencePaused": {
          "type": "boolean",
          "default": false
        },
        "recurrenceSeriesID": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 128
            },
            {
              "type": "null"
            }
          ]
        },
        "recurrenceAnchorDate": {
