// Config/Secrets.example.xcconfig
//
// Template for local build settings and optional build-time secrets. Copy this file to
// Config/Secrets.xcconfig (gitignored) and fill in the values you need.
// Without a Secrets.xcconfig the app still builds and runs; each integration
// simply reports "not configured" until its credentials are supplied.
//
// Apple signing:
//   Set this to your 10-character Apple Developer Team ID. Keep it blank for
//   unsigned local experiments that do not need entitlements.

SEPTENA_DEVELOPMENT_TEAM = YOURTEAMID

//
// Withings (Body) integration:
//   1. Register a dev app at https://developer.withings.com (Public Health
//      Data API). Set the redirect URI to:  septena://withings/callback
//   2. Replace the placeholders below with your client_id and client_secret.

WITHINGS_CLIENT_ID = your-withings-client-id
WITHINGS_CLIENT_SECRET = your-withings-client-secret

// Claude MCP gateway integration — CloudKit Web Services API token. Only needed
// if you run your own gateway; without it the in-app "keep Claude connected"
// refresh reports "not configured". Create it at CloudKit Console → your
// container → Tokens & Keys → API Tokens (its Sign-in Callback / URL Redirect
// must match your gateway, e.g. https://<gateway-host>/auth/apple/callback) and
// it must equal the gateway's CK_API_TOKEN.
CLOUDKIT_WEB_API_TOKEN = your-cloudkit-web-services-api-token
