// Config/Secrets.example.xcconfig
//
// Template for the Withings dev-app OAuth credentials. To enable the Withings
// (Body) integration in your own build:
//
//   1. Register a dev app at https://developer.withings.com (Public Health
//      Data API). Set the redirect URI to:  septena://withings/callback
//   2. Copy this file to Config/Secrets.xcconfig  (gitignored).
//   3. Replace the placeholders below with your client_id and client_secret.
//
// Without a Secrets.xcconfig the app still builds and runs; Withings simply
// reports "not configured" until credentials are supplied.

WITHINGS_CLIENT_ID = your-withings-client-id
WITHINGS_CLIENT_SECRET = your-withings-client-secret
