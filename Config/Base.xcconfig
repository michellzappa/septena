// Config/Base.xcconfig
//
// Committed base configuration for the Septena and SeptenaMac app targets,
// wired in via `configFiles` in project.yml. It declares empty defaults for
// optional local build settings (the Apple development team, Withings dev-app
// OAuth credentials, and the CloudKit Web Services API token used by the Claude
// gateway integration), then optionally layers in the real values from the
// gitignored Secrets.xcconfig (present only on a configured build machine / CI).
//
// These build settings reach the app through project.yml and Info.plist keys:
// DEVELOPMENT_TEAM for signing; WithingsClientID / WithingsClientSecret (read
// by WithingsAppCredentials in SeptenaCore/WithingsProvider.swift); and
// CloudKitWebAPIToken (read by ClaudeGatewayProvider in SeptenaCore).

SEPTENA_DEVELOPMENT_TEAM =
WITHINGS_CLIENT_ID =
WITHINGS_CLIENT_SECRET =
CLOUDKIT_WEB_API_TOKEN =

// Build number (CFBundleVersion). Lives here, not in project.yml, so it can be
// stamped from the git commit count by scripts/stamp-version.sh at archive
// time — monotonic and conflict-free across parallel sessions. The committed
// default (1) is fine for day-to-day Debug builds; only an archive needs the
// real, ever-increasing value. An xcconfig is the base layer, so project.yml
// must NOT set CURRENT_PROJECT_VERSION (a project-level value would win).
CURRENT_PROJECT_VERSION = 1377

// Optional include — silently skipped when the file is absent (fresh clone or
// CI without secrets), so the project still generates and builds. Copy
// Secrets.example.xcconfig to Secrets.xcconfig to provide real values.
#include? "Secrets.xcconfig"
